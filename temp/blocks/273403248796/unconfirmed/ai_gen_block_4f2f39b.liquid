{% doc %}
  @prompt
    説明文とコンタクトへ飛ぶボタン。ボタンやテキストはカスタマイズできるようにして, ボタンは線縁で
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-cta-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-cta__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0 0 {{ block.settings.spacing }}px;
  }

  .ai-contact-cta__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: transparent;
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
  }

  .ai-contact-cta__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }
{% endstyle %}

<div class="ai-contact-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.description != blank %}
    <div class="ai-contact-cta__description-{{ ai_gen_id }}">
      {{ block.settings.description }}
    </div>
  {% endif %}

  {% if block.settings.button_text != blank %}
    <a href="{{ block.settings.button_link }}" class="ai-contact-cta__button-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ご質問やご相談がございましたら、お気軽にお問い合わせください。</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "ボタンテキスト",
      "default": "お問い合わせ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "パディング",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "テキストとボタンの間隔",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "テキストスタイル"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "テキストサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景カラー",
      "default": "#fdfbf7"
    },
    {
      "type": "header",
      "content": "ボタンスタイル"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "ボタンテキストサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "ボタン縦パディング",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "ボタン横パディング",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "ボタン角の丸み",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_border_thickness",
      "label": "ボタン線の太さ",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "ボタン線カラー",
      "default": "#8f9eb2"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "ボタンテキストカラー",
      "default": "#8f9eb2"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "ホバー時背景カラー",
      "default": "#8f9eb2"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "ホバー時テキストカラー",
      "default": "#fdfbf7"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "ホバー時線カラー",
      "default": "#8f9eb2"
    }
  ],
  "presets": [
    {
      "name": "Contact CTA"
    }
  ]
}
{% endschema %}