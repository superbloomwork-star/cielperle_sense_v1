{% doc %}
  @prompt
    右寄せライン
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-right-line-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-right-line-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
  }

  .ai-right-line-element-{{ ai_gen_id }} {
    width: {{ block.settings.line_width }}%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    border-radius: {{ block.settings.line_radius }}px;
  }
{% endstyle %}

<div class="ai-right-line-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-right-line-container-{{ ai_gen_id }}">
    <div class="ai-right-line-element-{{ ai_gen_id }}"></div>
  </div>
</div>

{% schema %}
{
  "name": "右寄せライン",
  "settings": [
    {
      "type": "range",
      "id": "line_width",
      "label": "ライン幅",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "ライン太さ",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "ライン色",
      "default": "#8f9eb2"
    },
    {
      "type": "range",
      "id": "line_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "右寄せライン"
    }
  ]
}
{% endschema %}
