{% doc %}
  @prompt
    画像を3枚埋め込むことができるスライドショー
    ロゴ、説明文をスライドショーに重ねて中心に配置,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slideshow_height }}px;
  }

  .ai-slideshow-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-slideshow-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.content_spacing }}px;
    padding: 20px;
    z-index: 2;
  }

  .ai-slideshow-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-slideshow-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-slideshow-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
    max-width: {{ block.settings.text_max_width }}px;
    line-height: 1.5;
  }

  .ai-slideshow-navigation-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-arrows-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-slideshow-arrow-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-slideshow-arrow-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-slideshow-arrows-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-container-{{ ai_gen_id }} {
      height: {{ block.settings.slideshow_height | times: 0.6 }}px;
    }

    .ai-slideshow-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.7 }}px;
    }

    .ai-slideshow-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<slideshow-component-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slideshow-container-{{ ai_gen_id }}">
    <div class="ai-slideshow-slides-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        <div class="ai-slideshow-slide-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 2000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-slideshow-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slideshow-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-slideshow-overlay-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <div class="ai-slideshow-logo-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
          >
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-slideshow-text-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-slideshow-arrows-{{ ai_gen_id }} ai-slideshow-arrow-prev-{{ ai_gen_id }}"
        aria-label="前のスライド"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-slideshow-arrows-{{ ai_gen_id }} ai-slideshow-arrow-next-{{ ai_gen_id }}"
        aria-label="次のスライド"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-slideshow-navigation-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          <button
            class="ai-slideshow-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            aria-label="スライド {{ i }}"
            data-slide="{{ i }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</slideshow-component-{{ ai_gen_id }}>

<script>
  (function() {
    class SlideshowComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-arrow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slideshow-arrow-next-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.changeSlide(-1));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.changeSlide(1));
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
          });
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }

      changeSlide(direction) {
        this.currentSlide += direction;

        if (this.currentSlide > this.totalSlides) {
          this.currentSlide = 1;
        } else if (this.currentSlide < 1) {
          this.currentSlide = this.totalSlides;
        }

        this.updateSlides();
      }

      goToSlide(slideNumber) {
        this.currentSlide = slideNumber;
        this.updateSlides();
      }

      updateSlides() {
        this.slides.forEach((slide, index) => {
          if (index + 1 === this.currentSlide) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        this.dots.forEach((dot, index) => {
          if (index + 1 === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        const autoplayEnabled = {{ block.settings.autoplay }};
        const autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        if (autoplayEnabled) {
          this.autoplayInterval = setInterval(() => {
            this.changeSlide(1);
          }, autoplaySpeed);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('slideshow-component-{{ ai_gen_id }}', SlideshowComponent{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "スライドショー",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "画像 3"
    },
    {
      "type": "range",
      "id": "slideshow_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "スライドショーの高さ",
      "default": 600
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "オーバーレイコンテンツ"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "ロゴ"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 500,
      "step": 20,
      "unit": "px",
      "label": "ロゴの幅",
      "default": 200
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>あなたのストーリーをここに</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "テキストサイズ",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "テキストの最大幅",
      "default": 600
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "コンテンツ間隔",
      "default": 20
    },
    {
      "type": "header",
      "content": "スライドショー設定"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "自動再生",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "秒",
      "label": "自動再生速度",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 0.5,
      "max": 2,
      "step": 0.5,
      "unit": "秒",
      "label": "トランジション速度",
      "default": 1
    },
    {
      "type": "header",
      "content": "ナビゲーション"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "ドットを表示",
      "default": true
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "ドットサイズ",
      "default": 12
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "ドットカラー",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "矢印を表示",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "矢印サイズ",
      "default": 40
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "矢印背景色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "矢印カラー",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "スライドショー"
    }
  ]
}
{% endschema %}