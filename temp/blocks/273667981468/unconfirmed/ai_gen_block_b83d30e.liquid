{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像、右側にテキストと数量カウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-detail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-thumbnail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.thumbnail_gap }}px;
  }

  .ai-product-detail-thumbnail-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-product-detail-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 300;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .ai-product-detail-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .ai-product-detail-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 400;
  }

  .ai-product-detail-tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 300;
    font-style: italic;
    margin: 0;
  }

  .ai-product-detail-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    margin: 0;
  }

  .ai-product-detail-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-detail-quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-quantity-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-quantity-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .ai-product-detail-quantity-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  .ai-product-detail-quantity-input-{{ ai_gen_id }} {
    width: 50px;
    height: 40px;
    border: none;
    border-left: 1px solid {{ block.settings.border_color }};
    border-right: 1px solid {{ block.settings.border_color }};
    text-align: center;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_text_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    padding-top: {{ block.settings.features_padding_top }}px;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.features_spacing }}px 0;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .ai-product-detail-features-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    margin: 0 0 {{ block.settings.features_spacing }}px 0;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-detail-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-detail-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-product-detail-buttons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-grid-{{ ai_gen_id }}">
      <div class="ai-product-detail-left-{{ ai_gen_id }}">
        <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 1200 }}"
              alt="{{ block.settings.main_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-detail-thumbnail-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% assign thumbnail_key = 'thumbnail_' | append: i %}
            {% assign thumbnail = block.settings[thumbnail_key] %}
            <div class="ai-product-detail-thumbnail-{{ ai_gen_id }}">
              {% if thumbnail %}
                <img
                  src="{{ thumbnail | image_url: width: 300 }}"
                  alt="{{ thumbnail.alt | escape }}"
                  loading="lazy"
                  width="{{ thumbnail.width }}"
                  height="{{ thumbnail.height }}"
                >
              {% else %}
                <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ai-product-detail-right-{{ ai_gen_id }}">
        {% if block.settings.product_title != blank %}
          <h1 class="ai-product-detail-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h1>
        {% endif %}

        {% if block.settings.product_subtitle != blank %}
          <p class="ai-product-detail-subtitle-{{ ai_gen_id }}">{{ block.settings.product_subtitle }}</p>
        {% endif %}

        {% if block.settings.product_price != blank %}
          <div class="ai-product-detail-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</div>
        {% endif %}

        {% if block.settings.product_tagline != blank %}
          <p class="ai-product-detail-tagline-{{ ai_gen_id }}">{{ block.settings.product_tagline }}</p>
        {% endif %}

        {% if block.settings.product_description != blank %}
          <p class="ai-product-detail-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</p>
        {% endif %}

        <div class="ai-product-detail-quantity-{{ ai_gen_id }}">
          <span class="ai-product-detail-quantity-label-{{ ai_gen_id }}">数量</span>
          <div class="ai-product-detail-quantity-controls-{{ ai_gen_id }}">
            <button
              type="button"
              class="ai-product-detail-quantity-btn-{{ ai_gen_id }}"
              data-action="decrease"
              aria-label="数量を減らす"
            >
              −
            </button>
            <input
              type="number"
              class="ai-product-detail-quantity-input-{{ ai_gen_id }}"
              value="1"
              min="1"
              aria-label="数量"
            >
            <button
              type="button"
              class="ai-product-detail-quantity-btn-{{ ai_gen_id }}"
              data-action="increase"
              aria-label="数量を増やす"
            >
              +
            </button>
          </div>
        </div>

        <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}">
            {{ block.settings.purchase_button_label }}
          </button>
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}">
            {{ block.settings.subscription_button_label }}
          </button>
        </div>

        <div class="ai-product-detail-features-{{ ai_gen_id }}">
          {% if block.settings.features_heading != blank %}
            <h2 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h2>
          {% endif %}

          {% if block.settings.features_text != blank %}
            <p class="ai-product-detail-features-text-{{ ai_gen_id }}">{{ block.settings.features_text }}</p>
          {% endif %}

          <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
            {% if block.settings.features_image %}
              <img
                src="{{ block.settings.features_image | image_url: width: 800 }}"
                alt="{{ block.settings.features_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.features_image.width }}"
                height="{{ block.settings.features_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail-quantity-input-{{ ai_gen_id }}');
        this.decreaseBtn = this.querySelector('[data-action="decrease"]');
        this.increaseBtn = this.querySelector('[data-action="increase"]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.decreaseBtn) {
          this.decreaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(this.quantityInput.value) || 1;
            if (currentValue > 1) {
              this.quantityInput.value = currentValue - 1;
            }
          });
        }

        if (this.increaseBtn) {
          this.increaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(this.quantityInput.value) || 1;
            this.quantityInput.value = currentValue + 1;
          });
        }

        if (this.quantityInput) {
          this.quantityInput.addEventListener('change', () => {
            const value = parseInt(this.quantityInput.value);
            if (isNaN(value) || value < 1) {
              this.quantityInput.value = 1;
            }
          });
        }
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

