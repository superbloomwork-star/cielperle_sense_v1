{% doc %}
  @prompt
    タイトルテキスト
    画像
    
    上からこの順番に
    すべてを右半分に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-right-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-right-content-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-right-content-wrapper-{{ ai_gen_id }} {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
    align-items: {{ block.settings.alignment }};
  }

  .ai-right-content-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.text_alignment }};
    width: 100%;
  }

  .ai-right-content-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    width: 100%;
  }

  .ai-right-content-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-right-content-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-right-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-right-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    max-width: 400px;
  }

  .ai-right-content-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-right-content-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<ai-right-content-{{ ai_gen_id }}
  class="ai-right-content-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-right-content-container-{{ ai_gen_id }}">
    <div class="ai-right-content-wrapper-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-right-content-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-right-content-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      <div class="ai-right-content-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-right-content-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-right-content-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-right-content-empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ai-right-content-{{ ai_gen_id }}>

{% schema %}
{
  "name": "右側コンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトル",
      "default": "タイトルテキスト"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "テキスト",
      "default": "<p>ここにテキストを入力してください</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "要素間のスペース",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "配置",
      "options": [
        {
          "value": "flex-start",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "flex-end",
          "label": "右"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "テキストサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像の角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "右側コンテンツ"
    }
  ],
  "tag": null
}
{% endschema %}
