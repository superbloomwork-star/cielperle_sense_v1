{% doc %}
  @prompt
    画面を二分割
    左は画像
    右はうえからブランドロゴ、ロゴのふりがな、説明文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-brand-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-split-brand-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    gap: 0;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-brand-image-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-split-brand-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-brand-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-split-brand-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-split-brand-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.content_alignment }};
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    text-align: {% if block.settings.content_alignment == 'flex-start' %}left{% elsif block.settings.content_alignment == 'flex-end' %}right{% else %}center{% endif %};
  }

  .ai-split-brand-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-split-brand-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-split-brand-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 80px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-split-brand-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-split-brand-furigana-{{ ai_gen_id }} {
    font-size: {{ block.settings.furigana_size }}px;
    color: {{ block.settings.furigana_color }};
    margin-bottom: {{ block.settings.furigana_spacing }}px;
    line-height: 1.5;
  }

  .ai-split-brand-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    max-width: {{ block.settings.description_max_width }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-split-brand-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-brand-image-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-split-brand-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.6 }}px;
    }

    .ai-split-brand-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-split-brand-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<split-brand-{{ ai_gen_id }} class="ai-split-brand-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-brand-container-{{ ai_gen_id }}">
    <div class="ai-split-brand-image-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-split-brand-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-split-brand-content-{{ ai_gen_id }}">
      <div class="ai-split-brand-logo-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
          >
        {% else %}
          <div class="ai-split-brand-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.furigana != blank %}
        <div class="ai-split-brand-furigana-{{ ai_gen_id }}">
          {{ block.settings.furigana }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-split-brand-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</split-brand-{{ ai_gen_id }}>

{% schema %}
{
  "name": "二分割ブランド紹介",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "最小高さ",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "ブランドロゴ"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "ロゴ画像"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "ロゴ幅",
      "min": 80,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "ロゴ下の余白",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "ふりがな"
    },
    {
      "type": "richtext",
      "id": "furigana",
      "label": "ふりがな",
      "default": "<p>ブランド名のふりがな</p>"
    },
    {
      "type": "range",
      "id": "furigana_size",
      "label": "文字サイズ",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "furigana_color",
      "label": "文字色",
      "default": "#8f9eb2"
    },
    {
      "type": "range",
      "id": "furigana_spacing",
      "label": "下の余白",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ブランドの説明文をここに入力してください。</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "文字サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "文字色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "最大幅",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "コンテンツエリア"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "配置",
      "options": [
        {
          "value": "flex-start",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "flex-end",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "余白",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "背景色",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "二分割ブランド紹介"
    }
  ]
}
{% endschema %}
