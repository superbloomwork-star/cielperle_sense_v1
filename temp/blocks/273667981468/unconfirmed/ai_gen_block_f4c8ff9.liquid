{% doc %}
  @prompt
    テキストを右半分に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-text-layout__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .ai-text-layout__content-{{ ai_gen_id }} {
    width: 50%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-text-layout__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px 0;
  }

  .ai-text-layout__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-text-layout__content-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<text-layout-{{ ai_gen_id }}
  class="ai-text-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-text-layout__container-{{ ai_gen_id }}">
    <div class="ai-text-layout__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-text-layout__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="ai-text-layout__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</text-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class TextLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('text-layout-{{ ai_gen_id }}', TextLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "右配置テキスト",
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "見出し",
      "default": "見出しテキスト"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "テキスト",
      "default": "<p>ここにテキストを入力してください。このテキストは右半分に配置されます。</p>"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "パディング",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "見出しとテキストの間隔",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "見出しサイズ",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "テキストサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "右配置テキスト"
    }
  ]
}
{% endschema %}