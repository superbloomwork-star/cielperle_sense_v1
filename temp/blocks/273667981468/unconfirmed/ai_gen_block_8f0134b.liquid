{% doc %}
  @prompt
    空白幅
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spacer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: {{ block.settings.spacing_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-spacer-{{ ai_gen_id }} {
      height: {{ block.settings.spacing_mobile }}px;
    }
  }
{% endstyle %}

<spacer-block-{{ ai_gen_id }} class="ai-spacer-{{ ai_gen_id }}" {{ block.shopify_attributes }}></spacer-block-{{ ai_gen_id }}>

{% schema %}
{
  "name": "空白幅",
  "settings": [
    {
      "type": "range",
      "id": "spacing_desktop",
      "label": "デスクトップの高さ",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "label": "モバイルの高さ",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "空白幅"
    }
  ]
}
{% endschema %}
