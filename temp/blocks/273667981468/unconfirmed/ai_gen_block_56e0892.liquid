{% doc %}
  @prompt
    タイトルテキスト
    画像
    説明文
    
    右半分に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-right-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-content-right-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-content-right-left-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-content-right-right-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-content-right-title-{{ ai_gen_id }} {
    margin: 0 0 16px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.3;
  }

  .ai-content-right-description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
  }

  .ai-content-right-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-content-right-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-content-right-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-content-right-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-content-right-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-content-right-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 24px;
      padding: 24px;
    }

    .ai-content-right-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-content-right-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<content-right-{{ ai_gen_id }}
  class="ai-content-right-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-content-right-container-{{ ai_gen_id }}">
    <div class="ai-content-right-left-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-content-right-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-content-right-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="ai-content-right-right-{{ ai_gen_id }}">
      <div class="ai-content-right-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-content-right-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-content-right-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-content-right-empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</content-right-{{ ai_gen_id }}>

<script>
  (function() {
    class ContentRight{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('content-right-{{ ai_gen_id }}', ContentRight{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "コンテンツ右配置",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトル",
      "default": "タイトルテキスト"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ここに説明文を入力してください。商品やサービスの詳細を記載できます。</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "タイトル"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "フォントサイズ",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "テキスト色",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "フォントサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "テキスト色",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "コンテンツ右配置"
    }
  ]
}
{% endschema %}
