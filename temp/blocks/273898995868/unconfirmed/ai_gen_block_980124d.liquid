{% doc %}
  @prompt
    【構成案：ミニマルな2カラムレイアウト】
    
    1. 全体設定：
    - 背景色：ホワイト（#FFFFFF）
    - スタイル：清潔感、ミニマリズム、高級感
    
    2. セクション構成：
    - 左右2分割の「画像付きテキスト」セクション
    - 左側：垂直（3:4）の画像フレームを配置。画像はフルサイズで表示。
    - 右側：テキストエリアを配置。
    
    3. テキスト配置の詳細：
    - 配置：右カラムの「右下」または「中央」に寄せる
    - 整列：左揃え
    - フォント：明朝体（Serif）
    - 行間：広め（1.8以上）に設定し、余白を活かしたデザインにする
    
    4. 余白（パディング）：
    - 画像とテキストの間に十分な空間（ホワイトスペース）を確保する
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-minimal-two-column-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
  }

  .ai-minimal-two-column__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
  }

  .ai-minimal-two-column__image-column-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .ai-minimal-two-column__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-minimal-two-column__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-minimal-two-column__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-minimal-two-column__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-minimal-two-column__text-column-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    {% if block.settings.text_vertical_alignment == 'bottom' %}
      align-items: flex-end;
    {% elsif block.settings.text_vertical_alignment == 'center' %}
      align-items: center;
    {% else %}
      align-items: flex-start;
    {% endif %}
    {% if block.settings.text_horizontal_alignment == 'right' %}
      justify-content: flex-end;
    {% elsif block.settings.text_horizontal_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-minimal-two-column__text-content-{{ ai_gen_id }} {
    max-width: 100%;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-minimal-two-column__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-minimal-two-column__text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.body_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-minimal-two-column__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-minimal-two-column__image-column-{{ ai_gen_id }} {
      aspect-ratio: 4 / 3;
    }

    .ai-minimal-two-column__text-column-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding | times: 0.6 }}px;
    }

    .ai-minimal-two-column__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-minimal-two-column__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-minimal-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-minimal-two-column__container-{{ ai_gen_id }}">
    <div class="ai-minimal-two-column__image-column-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-minimal-two-column__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-minimal-two-column__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-minimal-two-column__empty-state-{{ ai_gen_id }}">
            画像を追加してください
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-minimal-two-column__text-column-{{ ai_gen_id }}">
      <div class="ai-minimal-two-column__text-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-minimal-two-column__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-minimal-two-column__text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Minimal two column",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "見出し",
      "default": "ミニマルデザイン"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>清潔感と高級感を兼ね備えた、シンプルで洗練されたデザインです。</p>"
    },
    {
      "type": "select",
      "id": "text_vertical_alignment",
      "label": "テキストの縦位置",
      "options": [
        {
          "value": "top",
          "label": "上"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "bottom",
          "label": "下"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "text_horizontal_alignment",
      "label": "テキストの横位置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキストの整列",
      "options": [
        {
          "value": "left",
          "label": "左揃え"
        },
        {
          "value": "center",
          "label": "中央揃え"
        },
        {
          "value": "right",
          "label": "右揃え"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "テキストエリアの余白",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "見出しのタイポグラフィ"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "見出しフォント",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "見出しサイズ",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "見出し行間",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "見出し下の余白",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "本文のタイポグラフィ"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "本文フォント",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "本文サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "本文行間",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.8
    }
  ],
  "presets": [
    {
      "name": "Minimal two column"
    }
  ]
}
{% endschema %}
