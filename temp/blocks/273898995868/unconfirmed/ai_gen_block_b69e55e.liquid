{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像(4:5)を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像(3:4)、右側にテキストと数量カウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像(1:1)を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
    ボタンのフォントもひな
    ボタンサイズは統一
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-detail-sub-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-product-detail-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 300;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  .ai-product-detail-product-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_subtitle_size }}px;
    margin: -16px 0 0 0;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-product-detail-product-info-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_info_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-product-detail-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-weight: 400;
  }

  .ai-product-detail-product-catchphrase-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_catchphrase_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }

  .ai-product-detail-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_description_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }

  .ai-product-detail-quantity-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-detail-quantity-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.quantity_label_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.quantity_border_color }};
    border-radius: {{ block.settings.quantity_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.quantity_button_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quantity_button_hover_bg }};
  }

  .ai-product-detail-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: {{ block.settings.quantity_label_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.button_font_size }}px;
    font-family: 'Hina Mincho', serif;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    min-width: {{ block.settings.button_min_width }}px;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    margin-top: 20px;
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_heading_size }}px;
    font-weight: 400;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-product-detail-features-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_description_size }}px;
    margin: 0 0 16px 0;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-detail-sub-images-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-product-detail-buttons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-left-{{ ai_gen_id }}">
      <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1000 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-product-detail-main-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-product-detail-sub-images-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign sub_image_key = 'sub_image_' | append: i
            assign sub_image = block.settings[sub_image_key]
          %}
          <div class="ai-product-detail-sub-image-{{ ai_gen_id }}">
            {% if sub_image %}
              <img
                src="{{ sub_image | image_url: width: 400 }}"
                alt="{{ sub_image.alt | escape }}"
                loading="lazy"
                width="{{ sub_image.width }}"
                height="{{ sub_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-sub-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-product-detail-right-{{ ai_gen_id }}">
      {% if block.settings.product_title != blank %}
        <h1 class="ai-product-detail-product-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h1>
      {% endif %}

      {% if block.settings.product_subtitle != blank %}
        <p class="ai-product-detail-product-subtitle-{{ ai_gen_id }}">{{ block.settings.product_subtitle }}</p>
      {% endif %}

      {% if block.settings.product_info != blank %}
        <p class="ai-product-detail-product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
      {% endif %}

      {% if block.settings.product_price != blank %}
        <p class="ai-product-detail-product-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</p>
      {% endif %}

      {% if block.settings.product_catchphrase != blank %}
        <p class="ai-product-detail-product-catchphrase-{{ ai_gen_id }}">{{ block.settings.product_catchphrase }}</p>
      {% endif %}

      {% if block.settings.product_description != blank %}
        <p class="ai-product-detail-product-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</p>
      {% endif %}

      <div class="ai-product-detail-quantity-wrapper-{{ ai_gen_id }}">
        <span class="ai-product-detail-quantity-label-{{ ai_gen_id }}">{{ block.settings.quantity_label }}</span>
        <div class="ai-product-detail-quantity-selector-{{ ai_gen_id }}">
          <button
            type="button"
            class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
            data-action="decrease"
            aria-label="数量を減らす"
          >
            −
          </button>
          <input
            type="number"
            class="ai-product-detail-quantity-input-{{ ai_gen_id }}"
            value="1"
            min="1"
            max="99"
            aria-label="数量"
          >
          <button
            type="button"
            class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
            data-action="increase"
            aria-label="数量を増やす"
          >
            +
          </button>
        </div>
      </div>

      <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
        <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}">
          {{ block.settings.primary_button_text }}
        </button>
        <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}">
          {{ block.settings.secondary_button_text }}
        </button>
      </div>

      <div class="ai-product-detail-features-{{ ai_gen_id }}">
        {% if block.settings.features_heading != blank %}
          <h2 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h2>
        {% endif %}

        {% if block.settings.features_description != blank %}
          <p class="ai-product-detail-features-description-{{ ai_gen_id }}">{{ block.settings.features_description }}</p>
        {% endif %}

        <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
          {% if block.settings.features_image %}
            <img
              src="{{ block.settings.features_image | image_url: width: 800 }}"
              alt="{{ block.settings.features_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.features_image.width }}"
              height="{{ block.settings.features_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-features-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail-quantity-input-{{ ai_gen_id }}');
        this.decreaseButton = this.querySelector('[data-action="decrease"]');
        this.increaseButton = this.querySelector('[data-action="increase"]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.decreaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.increaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          const maxValue = parseInt(this.quantityInput.max);
          if (currentValue < maxValue) {
            this.quantityInput.value = currentValue + 1;
          }
        });

        this.quantityInput.addEventListener('change', () => {
          let value = parseInt(this.quantityInput.value);
          const min = parseInt(this.quantityInput.min);
          const max = parseInt(this.quantityInput.max);

          if (isNaN(value) || value < min) {
            this.quantityInput.value = min;
          } else if (value > max) {
            this.quantityInput.value = max;
          }
        });
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

