{% doc %}
  @prompt
    【デザイン要件：イメージ＆テキストセクション】
    ・全体の構成：2カラムレイアウト。左側に大きなメイン画像、右側の「下部」にテキストを配置し、上部に大きな余白（ホワイトスペース）を作る。
    ・背景色：白（#FFFFFF）。
    
    【左側：ビジュアルの詳細】
    ・画像の内容：スキンケアボトルの物撮り。手前に透明なガラス瓶や水のような質感がボケて写り込んでいる、奥行きのある構図。
    ・トーン：清潔感のあるホワイトと柔らかなグレー。ミニマルで静かな高級感。
    
    【右側：テキストスタイル】
    ・配置：右側のカラムの「右下」に寄せて配置。
    ・フォント：エレガントで繊細な明朝体（セリフ体）。
    ・内容：
    テキストが入ります。テキストが入ります。
    テキストが入ります。テキストが入ります。
    テキストが入ります。テキストが入ります。
    テキストが入ります。テキストが入ります。
    テキストが入ります。テキストが入ります。
    テキストが入ります。テキストが入ります。
    
    【技術的仕様】
    ・画面サイズ：PC表示で横幅いっぱい（Full-width）。
    ・余白：右側カラムの上半分を大胆に空けることで、視覚的な抜け感を作る。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
    min-height: 600px;
  }

  .ai-image-text-image-column-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-image-text-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-text-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-text-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-text-column-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding: {{ block.settings.text_padding_top }}px {{ block.settings.text_padding_right }}px {{ block.settings.text_padding_bottom }}px {{ block.settings.text_padding_left }}px;
  }

  .ai-image-text-text-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.text_max_width }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-text-text-content-{{ ai_gen_id }} p {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
    letter-spacing: {{ block.settings.letter_spacing }}em;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .ai-image-text-image-column-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .ai-image-text-text-column-{{ ai_gen_id }} {
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .ai-image-text-text-content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-image-text-text-content-{{ ai_gen_id }} p {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<image-text-section-{{ ai_gen_id }}
  class="ai-image-text-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-text-image-column-{{ ai_gen_id }}">
      <div class="ai-image-text-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-image-text-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-image-text-empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-image-text-text-column-{{ ai_gen_id }}">
      <div class="ai-image-text-text-content-{{ ai_gen_id }}">
        {% if block.settings.text != blank %}
          {{ block.settings.text }}
        {% else %}
          <p>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。</p>
        {% endif %}
      </div>
    </div>
  </div>
</image-text-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('image-text-section-{{ ai_gen_id }}', ImageTextSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image & text section",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "テキスト",
      "default": "<p>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。<br>テキストが入ります。テキストが入ります。</p>"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "フォントサイズ",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "行の高さ",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "文字間隔",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "unit": "em",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "テキスト最大幅",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "テキストエリアの余白"
    },
    {
      "type": "range",
      "id": "text_padding_top",
      "label": "上部余白",
      "min": 0,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "text_padding_right",
      "label": "右側余白",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "text_padding_bottom",
      "label": "下部余白",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "text_padding_left",
      "label": "左側余白",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Image & text section"
    }
  ],
  "tag": null
}
{% endschema %}
