{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像(4:5)を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像(3:4)、右側にテキストと数量カウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像(1:1)を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
    ボタンのフォントもひな
    ボタンサイズは統一
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-detail-sub-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-product-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_name_font.family }}, {{ block.settings.product_name_font.fallback_families }};
    font-weight: {{ block.settings.product_name_font.weight }};
    font-size: {{ block.settings.product_name_size }}px;
    line-height: {{ block.settings.product_name_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-name-ja-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_name_ja_font.family }}, {{ block.settings.product_name_ja_font.fallback_families }};
    font-weight: {{ block.settings.product_name_ja_font.weight }};
    font-size: {{ block.settings.product_name_ja_size }}px;
    line-height: {{ block.settings.product_name_ja_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-info-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-catchphrase-{{ ai_gen_id }} {
    font-family: {{ block.settings.catchphrase_font.family }}, {{ block.settings.catchphrase_font.fallback_families }};
    font-weight: {{ block.settings.catchphrase_font.weight }};
    font-size: {{ block.settings.catchphrase_size }}px;
    line-height: {{ block.settings.catchphrase_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-detail-quantity-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-quantity-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.quantity_button_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quantity_button_hover_bg }};
  }

  .ai-product-detail-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-features-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-top: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-product-detail-sub-images-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-left-{{ ai_gen_id }}">
      <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1000 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-product-detail-main-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-product-detail-sub-images-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign image_key = 'sub_image_' | append: i
            assign sub_image = block.settings[image_key]
          %}
          <div class="ai-product-detail-sub-image-{{ ai_gen_id }}">
            {% if sub_image %}
              <img
                src="{{ sub_image | image_url: width: 400 }}"
                alt="{{ sub_image.alt | escape }}"
                loading="lazy"
                width="{{ sub_image.width }}"
                height="{{ sub_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-sub-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-product-detail-right-{{ ai_gen_id }}">
      {% if block.settings.product_name_en != blank %}
        <h2 class="ai-product-detail-product-name-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</h2>
      {% endif %}

      {% if block.settings.product_name_ja != blank %}
        <h3 class="ai-product-detail-product-name-ja-{{ ai_gen_id }}">{{ block.settings.product_name_ja }}</h3>
      {% endif %}

      {% if block.settings.product_info != blank %}
        <p class="ai-product-detail-product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
      {% endif %}

      {% if block.settings.catchphrase != blank %}
        <p class="ai-product-detail-catchphrase-{{ ai_gen_id }}">{{ block.settings.catchphrase }}</p>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-product-detail-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}

      <div class="ai-product-detail-quantity-{{ ai_gen_id }}">
        <span class="ai-product-detail-quantity-label-{{ ai_gen_id }}">数量</span>
        <div class="ai-product-detail-quantity-controls-{{ ai_gen_id }}">
          <button
            type="button"
            class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
            data-action="decrease"
            aria-label="数量を減らす"
          >
            −
          </button>
          <input
            type="number"
            class="ai-product-detail-quantity-input-{{ ai_gen_id }}"
            value="1"
            min="1"
            aria-label="数量"
          >
          <button
            type="button"
            class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
            data-action="increase"
            aria-label="数量を増やす"
          >
            +
          </button>
        </div>
      </div>

      <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
        {% if block.settings.primary_button_text != blank %}
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}">
            {{ block.settings.primary_button_text }}
          </button>
        {% endif %}

        {% if block.settings.secondary_button_text != blank %}
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}">
            {{ block.settings.secondary_button_text }}
          </button>
        {% endif %}
      </div>

      <div class="ai-product-detail-features-{{ ai_gen_id }}">
        {% if block.settings.features_heading != blank %}
          <h4 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h4>
        {% endif %}

        {% if block.settings.features_text != blank %}
          <p class="ai-product-detail-features-text-{{ ai_gen_id }}">{{ block.settings.features_text }}</p>
        {% endif %}

        <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
          {% if block.settings.features_image %}
            <img
              src="{{ block.settings.features_image | image_url: width: 600 }}"
              alt="{{ block.settings.features_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.features_image.width }}"
              height="{{ block.settings.features_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-features-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail-quantity-input-{{ ai_gen_id }}');
        this.decreaseButton = this.querySelector('[data-action="decrease"]');
        this.increaseButton = this.querySelector('[data-action="increase"]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.decreaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.increaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          this.quantityInput.value = currentValue + 1;
        });

        this.quantityInput.addEventListener('change', () => {
          const value = parseInt(this.quantityInput.value);
          if (value < 1 || isNaN(value)) {
            this.quantityInput.value = 1;
          }
        });
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

