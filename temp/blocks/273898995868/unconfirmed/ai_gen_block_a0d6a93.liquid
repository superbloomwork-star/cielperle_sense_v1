{% doc %}
  @prompt
    左半分を画像
    右半分をブランドロゴ、ロゴのふりがな、説明文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-brand-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
  }

  .ai-brand-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
  }

  .ai-brand-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-brand-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-brand-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-brand-content-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_background_color }};
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: center;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-brand-logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-brand-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 80px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.logo_spacing }}px;
    border-radius: 4px;
  }

  .ai-brand-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-brand-furigana-{{ ai_gen_id }} {
    font-size: {{ block.settings.furigana_size }}px;
    color: {{ block.settings.furigana_color }};
    margin-bottom: {{ block.settings.furigana_spacing }}px;
    line-height: 1.5;
  }

  .ai-brand-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-brand-image-wrapper-{{ ai_gen_id }},
    .ai-brand-content-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .ai-brand-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<brand-section-{{ ai_gen_id }}
  class="ai-brand-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-brand-container-{{ ai_gen_id }}">
    <div class="ai-brand-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.brand_image %}
        <img
          src="{{ block.settings.brand_image | image_url: width: 1200 }}"
          alt="{{ block.settings.brand_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.brand_image.width }}"
          height="{{ block.settings.brand_image.height }}"
          class="ai-brand-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-brand-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-brand-content-{{ ai_gen_id }}">
      {% if block.settings.brand_logo %}
        <img
          src="{{ block.settings.brand_logo | image_url: width: 600 }}"
          alt="{{ block.settings.brand_logo.alt | escape }}"
          loading="lazy"
          class="ai-brand-logo-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-brand-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.furigana != blank %}
        <div class="ai-brand-furigana-{{ ai_gen_id }}">
          {{ block.settings.furigana }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-brand-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</brand-section-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Brand introduction",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Brand image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Logo spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Furigana"
    },
    {
      "type": "inline_richtext",
      "id": "furigana",
      "label": "Furigana text",
      "default": "しえるぺるる"
    },
    {
      "type": "range",
      "id": "furigana_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Furigana size",
      "default": 14
    },
    {
      "type": "color",
      "id": "furigana_color",
      "label": "Furigana color",
      "default": "#8f9eb2"
    },
    {
      "type": "range",
      "id": "furigana_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Furigana spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>ブランドの説明文をここに入力してください。</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Content padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content background",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Brand introduction"
    }
  ]
}
{% endschema %}
