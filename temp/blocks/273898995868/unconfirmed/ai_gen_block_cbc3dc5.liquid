{% doc %}
  @prompt
    画像を右、画像の左下に説明文、見出しなし、ブロックを中央配置、画像とテキストの幅は調整できるようにして、テキストは画像寄せ
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-block-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 20px;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-end;
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
  }

  .ai-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}%;
    order: 2;
  }

  .ai-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-text-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.text_width }}%;
    order: 1;
    text-align: right;
  }

  .ai-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      order: 1;
    }

    .ai-text-wrapper-{{ ai_gen_id }} {
      width: 100%;
      order: 2;
      text-align: {{ block.settings.text_alignment_mobile }};
    }
  }
{% endstyle %}

<div class="ai-image-text-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-text-wrapper-{{ ai_gen_id }}">
      {% if block.settings.text != blank %}
        <div class="ai-text-content-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "画像とテキスト",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "画像の幅",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像の角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "説明文",
      "default": "<p>ここに説明文を入力してください</p>"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "テキストの幅",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストの色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "テキストサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "行の高さ",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "最大幅",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "gap",
      "label": "画像とテキストの間隔",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "モバイル設定"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "モバイルの間隔",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "モバイルのテキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "画像とテキスト"
    }
  ]
}
{% endschema %}
