{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像、右側にテキストと数量カウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
    ボタンのフォントもひな
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-detail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-product-detail-images-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-sub-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.sub_image_gap }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.info_gap }}px;
  }

  .ai-product-detail-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-detail-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: {{ block.settings.subtitle_weight }};
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-product-detail-price-volume-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: {{ block.settings.price_weight }};
  }

  .ai-product-detail-catchphrase-{{ ai_gen_id }} {
    font-size: {{ block.settings.catchphrase_size }}px;
    color: {{ block.settings.catchphrase_color }};
    font-weight: {{ block.settings.catchphrase_weight }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-product-detail-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  .ai-product-detail-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-detail-quantity-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-quantity-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.quantity_button_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quantity_button_hover_bg }};
  }

  .ai-product-detail-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-family: 'Hina Mincho', serif;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    margin-top: {{ block.settings.features_margin_top }}px;
    padding-top: {{ block.settings.features_padding_top }}px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_heading_size }}px;
    font-weight: {{ block.settings.features_heading_weight }};
    color: {{ block.settings.features_heading_color }};
    margin: 0 0 {{ block.settings.features_heading_margin }}px 0;
    line-height: 1.4;
  }

  .ai-product-detail-features-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_text_size }}px;
    color: {{ block.settings.features_text_color }};
    line-height: {{ block.settings.features_text_line_height }};
    margin: 0 0 {{ block.settings.features_text_margin }}px 0;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .ai-product-detail-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-detail-sub-images-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-product-detail-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-product-detail-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-product-detail-buttons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-grid-{{ ai_gen_id }}">
      <div class="ai-product-detail-images-{{ ai_gen_id }}">
        <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 1200 }}"
              alt="{{ block.settings.main_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-main-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-detail-sub-images-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% assign sub_image_key = 'sub_image_' | append: i %}
            {% assign sub_image = block.settings[sub_image_key] %}
            <div class="ai-product-detail-sub-image-{{ ai_gen_id }}">
              {% if sub_image %}
                <img
                  src="{{ sub_image | image_url: width: 400 }}"
                  alt="{{ sub_image.alt | escape }}"
                  loading="lazy"
                  width="{{ sub_image.width }}"
                  height="{{ sub_image.height }}"
                >
              {% else %}
                <div class="ai-product-detail-sub-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ai-product-detail-info-{{ ai_gen_id }}">
        {% if block.settings.product_title_en != blank %}
          <h2 class="ai-product-detail-title-{{ ai_gen_id }}">{{ block.settings.product_title_en }}</h2>
        {% endif %}

        {% if block.settings.product_title_ja != blank %}
          <p class="ai-product-detail-subtitle-{{ ai_gen_id }}">{{ block.settings.product_title_ja }}</p>
        {% endif %}

        <div class="ai-product-detail-price-volume-{{ ai_gen_id }}">
          {% if block.settings.product_volume != blank %}
            <span>{{ block.settings.product_volume }}</span>
          {% endif %}
          {% if block.settings.product_price != blank %}
            <span>{{ block.settings.product_price }}</span>
          {% endif %}
        </div>

        {% if block.settings.catchphrase != blank %}
          <p class="ai-product-detail-catchphrase-{{ ai_gen_id }}">{{ block.settings.catchphrase }}</p>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-product-detail-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        <div class="ai-product-detail-quantity-{{ ai_gen_id }}">
          <span class="ai-product-detail-quantity-label-{{ ai_gen_id }}">数量</span>
          <div class="ai-product-detail-quantity-controls-{{ ai_gen_id }}">
            <button
              type="button"
              class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
              data-action="decrease"
            >
              −
            </button>
            <input
              type="number"
              class="ai-product-detail-quantity-input-{{ ai_gen_id }}"
              value="1"
              min="1"
              readonly
            >
            <button
              type="button"
              class="ai-product-detail-quantity-button-{{ ai_gen_id }}"
              data-action="increase"
            >
              +
            </button>
          </div>
        </div>

        <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
          {% if block.settings.primary_button_text != blank %}
            <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}">
              {{ block.settings.primary_button_text }}
            </button>
          {% endif %}

          {% if block.settings.secondary_button_text != blank %}
            <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}">
              {{ block.settings.secondary_button_text }}
            </button>
          {% endif %}
        </div>

        <div class="ai-product-detail-features-{{ ai_gen_id }}">
          {% if block.settings.features_heading != blank %}
            <h3 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h3>
          {% endif %}

          {% if block.settings.features_text != blank %}
            <div class="ai-product-detail-features-text-{{ ai_gen_id }}">{{ block.settings.features_text }}</div>
          {% endif %}

          <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
            {% if block.settings.features_image %}
              <img
                src="{{ block.settings.features_image | image_url: width: 800 }}"
                alt="{{ block.settings.features_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.features_image.width }}"
                height="{{ block.settings.features_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-features-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail-quantity-input-{{ ai_gen_id }}');
        this.decreaseButton = this.querySelector('[data-action="decrease"]');
        this.increaseButton = this.querySelector('[data-action="increase"]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.decreaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.increaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          this.quantityInput.value = currentValue + 1;
        });
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

