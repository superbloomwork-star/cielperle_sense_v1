{% doc %}
  @prompt
    左半分:写真
    右半分:ロゴ、ロゴのふりがな、説明文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-split-content-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-content-image-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-content-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-split-content-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-split-content-text-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    padding: {{ block.settings.text_padding }}px;
    background-color: {{ block.settings.text_background_color }};
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.text_alignment }};
    text-align: {{ block.settings.text_alignment }};
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-content-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-split-content-logo-{{ ai_gen_id }} img {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-split-content-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 80px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-split-content-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-split-content-furigana-{{ ai_gen_id }} {
    font-size: {{ block.settings.furigana_size }}px;
    color: {{ block.settings.furigana_color }};
    margin-bottom: {{ block.settings.furigana_spacing }}px;
    line-height: 1.5;
  }

  .ai-split-content-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    max-width: {{ block.settings.description_max_width }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-split-content-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-content-image-{{ ai_gen_id }},
    .ai-split-content-text-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .ai-split-content-text-{{ ai_gen_id }} {
      align-items: center;
      text-align: center;
    }

    .ai-split-content-description-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-split-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-content-wrapper-{{ ai_gen_id }}">
    <div class="ai-split-content-image-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-split-content-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-split-content-empty-state-{{ ai_gen_id }}">
            画像を追加してください
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-split-content-text-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <div class="ai-split-content-logo-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
          >
        </div>
      {% elsif block.settings.show_logo_placeholder %}
        <div class="ai-split-content-logo-{{ ai_gen_id }}">
          <div class="ai-split-content-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.furigana != blank %}
        <div class="ai-split-content-furigana-{{ ai_gen_id }}">
          {{ block.settings.furigana }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-split-content-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "左右分割コンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "最小高さ",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "ロゴ"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "ロゴ画像"
    },
    {
      "type": "checkbox",
      "id": "show_logo_placeholder",
      "label": "ロゴのプレースホルダーを表示",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "ロゴの幅",
      "min": 80,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "ロゴの下余白",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "ふりがな"
    },
    {
      "type": "richtext",
      "id": "furigana",
      "label": "ふりがな",
      "default": "<p>しえるぺるる</p>"
    },
    {
      "type": "range",
      "id": "furigana_size",
      "label": "ふりがなのサイズ",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "furigana_color",
      "label": "ふりがなの色",
      "default": "#8f9eb2"
    },
    {
      "type": "range",
      "id": "furigana_spacing",
      "label": "ふりがなの下余白",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ここに説明文を入力してください。ブランドやサービスの詳細を記載できます。</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "説明文のサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文の色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "説明文の最大幅",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "テキストエリア"
    },
    {
      "type": "color",
      "id": "text_background_color",
      "label": "背景色",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "内側の余白",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキストの配置",
      "options": [
        {
          "value": "flex-start",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "flex-end",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップの幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "左右分割コンテンツ"
    }
  ]
}
{% endschema %}
