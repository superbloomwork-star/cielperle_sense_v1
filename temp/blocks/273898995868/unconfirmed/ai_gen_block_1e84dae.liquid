{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像(4:5)を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像(3:4)、右側にテキストとカウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像(1:1)を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
    ボタンのフォントもひな
    ボタンサイズは統一
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-detail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-thumbnail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.thumbnail_gap }}px;
  }

  .ai-product-detail-thumbnail-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-product-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_name_font.family }}, {{ block.settings.product_name_font.fallback_families }};
    font-weight: {{ block.settings.product_name_font.weight }};
    font-size: {{ block.settings.product_name_size }}px;
    line-height: {{ block.settings.product_name_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }};
    font-weight: {{ block.settings.subtitle_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: {{ block.settings.subtitle_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-info-{{ ai_gen_id }} {
    font-family: {{ block.settings.info_font.family }}, {{ block.settings.info_font.fallback_families }};
    font-weight: {{ block.settings.info_font.weight }};
    font-size: {{ block.settings.info_size }}px;
    line-height: {{ block.settings.info_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-size: {{ block.settings.price_size }}px;
    line-height: {{ block.settings.price_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-tagline-{{ ai_gen_id }} {
    font-family: {{ block.settings.tagline_font.family }}, {{ block.settings.tagline_font.fallback_families }};
    font-weight: {{ block.settings.tagline_font.weight }};
    font-size: {{ block.settings.tagline_size }}px;
    line-height: {{ block.settings.tagline_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-product-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.button_gap }}px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_font_size }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: all 0.3s ease;
    width: {{ block.settings.button_width }}px;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    color: {{ block.settings.primary_button_hover_text }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_text_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
    color: {{ block.settings.secondary_button_hover_text }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    margin-top: {{ block.settings.features_margin_top }}px;
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.features_heading_font.family }}, {{ block.settings.features_heading_font.fallback_families }};
    font-weight: {{ block.settings.features_heading_font.weight }};
    font-size: {{ block.settings.features_heading_size }}px;
    line-height: {{ block.settings.features_heading_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.features_heading_margin }}px 0;
  }

  .ai-product-detail-features-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.features_text_font.family }}, {{ block.settings.features_text_font.fallback_families }};
    font-weight: {{ block.settings.features_text_font.weight }};
    font-size: {{ block.settings.features_text_size }}px;
    line-height: {{ block.settings.features_text_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.features_text_margin }}px 0;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-detail-thumbnail-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }}
  class="ai-product-detail-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-grid-{{ ai_gen_id }}">
      <div class="ai-product-detail-left-{{ ai_gen_id }}">
        <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 1000 }}"
              alt="{{ block.settings.main_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-detail-thumbnail-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% liquid
              assign thumbnail_key = 'thumbnail_' | append: i
              assign thumbnail = block.settings[thumbnail_key]
            %}
            <div class="ai-product-detail-thumbnail-{{ ai_gen_id }}">
              {% if thumbnail %}
                <img
                  src="{{ thumbnail | image_url: width: 400 }}"
                  alt="{{ thumbnail.alt | escape }}"
                  loading="lazy"
                  width="{{ thumbnail.width }}"
                  height="{{ thumbnail.height }}"
                >
              {% else %}
                <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ai-product-detail-right-{{ ai_gen_id }}">
        {% if block.settings.product_name != blank %}
          <h1 class="ai-product-detail-product-name-{{ ai_gen_id }}">{{ block.settings.product_name }}</h1>
        {% endif %}

        {% if block.settings.product_subtitle != blank %}
          <p class="ai-product-detail-product-subtitle-{{ ai_gen_id }}">{{ block.settings.product_subtitle }}</p>
        {% endif %}

        {% if block.settings.product_info != blank %}
          <p class="ai-product-detail-product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
        {% endif %}

        {% if block.settings.product_price != blank %}
          <p class="ai-product-detail-product-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</p>
        {% endif %}

        {% if block.settings.product_tagline != blank %}
          <p class="ai-product-detail-product-tagline-{{ ai_gen_id }}">{{ block.settings.product_tagline }}</p>
        {% endif %}

        {% if block.settings.product_description != blank %}
          <p class="ai-product-detail-product-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</p>
        {% endif %}

        <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
          {% if block.settings.primary_button_label != blank %}
            <a
              href="{{ block.settings.primary_button_link }}"
              class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.primary_button_label }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank %}
            <a
              href="{{ block.settings.secondary_button_link }}"
              class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.secondary_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="ai-product-detail-features-{{ ai_gen_id }}">
          {% if block.settings.features_heading != blank %}
            <h2 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h2>
          {% endif %}

          {% if block.settings.features_text != blank %}
            <p class="ai-product-detail-features-text-{{ ai_gen_id }}">{{ block.settings.features_text }}</p>
          {% endif %}

          <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
            {% if block.settings.features_image %}
              <img
                src="{{ block.settings.features_image | image_url: width: 800 }}"
                alt="{{ block.settings.features_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.features_image.width }}"
                height="{{ block.settings.features_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

