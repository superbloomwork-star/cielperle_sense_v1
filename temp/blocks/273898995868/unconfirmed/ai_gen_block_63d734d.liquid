{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像、右側にテキストと数量カウンターと購入ボタンと定期購入ボタン）ボタンは左寄せ。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 0;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-detail-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-product-detail-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-detail-sub-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.sub_image_gap }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-sub-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-product-detail-sub-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 300;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-product-detail-product-name-ja-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_ja_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-detail-product-info-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_info_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.8;
  }

  .ai-product-detail-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-detail-tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-detail-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.8;
  }

  .ai-product-detail-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-detail-quantity-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-quantity-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-quantity-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-quantity-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-detail-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    min-width: {{ block.settings.button_min_width }}px;
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
  }

  .ai-product-detail-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_bg }};
    color: {{ block.settings.secondary_button_color }};
  }

  .ai-product-detail-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    margin-top: {{ block.settings.features_margin_top }}px;
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_heading_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.5;
  }

  .ai-product-detail-features-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    line-height: 1.8;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-detail-features-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-product-detail-features-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-product-detail-product-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_name_size | times: 0.8 }}px;
    }

    .ai-product-detail-product-name-ja-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_name_ja_size | times: 0.9 }}px;
    }

    .ai-product-detail-buttons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-grid-{{ ai_gen_id }}">
      <div class="ai-product-detail-left-{{ ai_gen_id }}">
        <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 1200 }}"
              alt="{{ block.settings.main_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-detail-sub-images-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% liquid
              assign image_key = 'sub_image_' | append: i
              assign sub_image = block.settings[image_key]
            %}
            <div class="ai-product-detail-sub-image-{{ ai_gen_id }}">
              {% if sub_image %}
                <img
                  src="{{ sub_image | image_url: width: 400 }}"
                  alt="{{ sub_image.alt | escape }}"
                  loading="lazy"
                  width="{{ sub_image.width }}"
                  height="{{ sub_image.height }}"
                >
              {% else %}
                <div class="ai-product-detail-sub-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ai-product-detail-right-{{ ai_gen_id }}">
        {% if block.settings.product_name_en != blank %}
          <h2 class="ai-product-detail-product-name-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</h2>
        {% endif %}

        {% if block.settings.product_name_ja != blank %}
          <h3 class="ai-product-detail-product-name-ja-{{ ai_gen_id }}">{{ block.settings.product_name_ja }}</h3>
        {% endif %}

        {% if block.settings.product_info != blank %}
          <p class="ai-product-detail-product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
        {% endif %}

        {% if block.settings.price != blank %}
          <p class="ai-product-detail-price-{{ ai_gen_id }}">{{ block.settings.price }}</p>
        {% endif %}

        {% if block.settings.tagline != blank %}
          <p class="ai-product-detail-tagline-{{ ai_gen_id }}">{{ block.settings.tagline }}</p>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="ai-product-detail-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
        {% endif %}

        <div class="ai-product-detail-quantity-{{ ai_gen_id }}">
          <span class="ai-product-detail-quantity-label-{{ ai_gen_id }}">数量</span>
          <div class="ai-product-detail-quantity-controls-{{ ai_gen_id }}">
            <button
              class="ai-product-detail-quantity-btn-{{ ai_gen_id }} ai-product-detail-quantity-minus-{{ ai_gen_id }}"
              type="button"
              aria-label="数量を減らす"
            >
              −
            </button>
            <input
              type="number"
              class="ai-product-detail-quantity-input-{{ ai_gen_id }}"
              value="1"
              min="1"
              aria-label="数量"
            >
            <button
              class="ai-product-detail-quantity-btn-{{ ai_gen_id }} ai-product-detail-quantity-plus-{{ ai_gen_id }}"
              type="button"
              aria-label="数量を増やす"
            >
              +
            </button>
          </div>
        </div>

        <div class="ai-product-detail-buttons-{{ ai_gen_id }}">
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-primary-{{ ai_gen_id }}">
            {{ block.settings.primary_btn_text }}
          </button>
          <button class="ai-product-detail-button-{{ ai_gen_id }} ai-product-detail-button-secondary-{{ ai_gen_id }}">
            {{ block.settings.secondary_btn_text }}
          </button>
        </div>

        <div class="ai-product-detail-features-{{ ai_gen_id }}">
          {% if block.settings.features_heading != blank %}
            <h4 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h4>
          {% endif %}

          {% if block.settings.features_text != blank %}
            <p class="ai-product-detail-features-text-{{ ai_gen_id }}">{{ block.settings.features_text }}</p>
          {% endif %}

          <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
            {% if block.settings.features_image %}
              <img
                src="{{ block.settings.features_image | image_url: width: 800 }}"
                alt="{{ block.settings.features_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.features_image.width }}"
                height="{{ block.settings.features_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-features-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail-quantity-input-{{ ai_gen_id }}');
        this.minusBtn = this.querySelector('.ai-product-detail-quantity-minus-{{ ai_gen_id }}');
        this.plusBtn = this.querySelector('.ai-product-detail-quantity-plus-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.minusBtn.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.plusBtn.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          this.quantityInput.value = currentValue + 1;
        });

        this.quantityInput.addEventListener('change', () => {
          const value = parseInt(this.quantityInput.value);
          if (value < 1 || isNaN(value)) {
            this.quantityInput.value = 1;
          }
        });
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

