{% doc %}
  @prompt
    タイトルテキスト(フォントサイズを調整）
    画像(横並びで２つ）
    説明文（それぞれの画像の下に１つずつ中央揃え）
    
    上からこの順番に
    すべてを右半分に配置
    
    コンテンツ幅を1間隔で調節
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-image-layout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-two-image-layout__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .ai-two-image-layout__content-{{ ai_gen_id }} {
    width: {{ block.settings.content_width }}%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-two-image-layout__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    margin: 0;
    color: {{ block.settings.title_color }};
    text-align: left;
  }

  .ai-two-image-layout__images-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
  }

  .ai-two-image-layout__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-two-image-layout__image-container-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-image-layout__image-container-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-two-image-layout__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-image-layout__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-two-image-layout__description-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-two-image-layout__content-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-two-image-layout__images-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<two-image-layout-{{ ai_gen_id }} class="ai-two-image-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-image-layout__container-{{ ai_gen_id }}">
    <div class="ai-two-image-layout__content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-two-image-layout__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-two-image-layout__images-{{ ai_gen_id }}">
        <div class="ai-two-image-layout__image-wrapper-{{ ai_gen_id }}">
          <div class="ai-two-image-layout__image-container-{{ ai_gen_id }}">
            {% if block.settings.image_1 %}
              <img
                src="{{ block.settings.image_1 | image_url: width: 800 }}"
                alt="{{ block.settings.image_1.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_1.width }}"
                height="{{ block.settings.image_1.height }}"
              >
            {% else %}
              <div class="ai-two-image-layout__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if block.settings.description_1 != blank %}
            <p class="ai-two-image-layout__description-{{ ai_gen_id }}">{{ block.settings.description_1 }}</p>
          {% endif %}
        </div>

        <div class="ai-two-image-layout__image-wrapper-{{ ai_gen_id }}">
          <div class="ai-two-image-layout__image-container-{{ ai_gen_id }}">
            {% if block.settings.image_2 %}
              <img
                src="{{ block.settings.image_2 | image_url: width: 800 }}"
                alt="{{ block.settings.image_2.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_2.width }}"
                height="{{ block.settings.image_2.height }}"
              >
            {% else %}
              <div class="ai-two-image-layout__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if block.settings.description_2 != blank %}
            <p class="ai-two-image-layout__description-{{ ai_gen_id }}">{{ block.settings.description_2 }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</two-image-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoImageLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('two-image-layout-{{ ai_gen_id }}', TwoImageLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two image layout",
  "settings": [
    {
      "type": "header",
      "content": "タイトル"
    },
    {
      "type": "text",
      "id": "title",
      "label": "タイトルテキスト",
      "default": "タイトル"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "フォントサイズ",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "画像1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "description_1",
      "label": "説明文",
      "default": "説明文1"
    },
    {
      "type": "header",
      "content": "画像2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "description_2",
      "label": "説明文",
      "default": "説明文2"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "説明文フォントサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文カラー",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像の角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "コンテンツ幅",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Two image layout"
    }
  ]
}
{% endschema %}
