{% doc %}
  @prompt
    【レイアウト】
      - セクション高さ 90vh、横幅フル、左右パディングなし
      - 背景：画像フル表示（image_picker設定、キー名 background_image）、ダークオーバーレイ調整可（0〜50%、初期値8%）
      - 中央寄せ Group ブロック、2カラム、縦中央揃え、最大幅 1200px、カラム間 80px
      - モバイル：縦積み、背景画像は全幅維持
    
      【左カラム / デスクトップ 5/12幅】
      - 商品画像ブロック1点、白カード（#FFFFFF）背景
      - カード内側パディング60px、ドロップシャドウ 0 20px 60px rgba(0,0,0,0.15)
      - 画像はobject-fit: contain、アスペクト比 3:4
    
      【右カラム / 6/12幅、1/12オフセット】
      - テキストブロックを縦に積む、グループ間24px、文字色アイボリー（#F5F0E8）
      - ラベル：セリフ12px、字間0.1em（例「商品詳細」）
      - 商品名EN：セリフ18px
      - 商品名JP：セリフ16px
      - 容量＋価格：セリフ14px（例「120ml　¥9,800 tax in」）
      - 40px空けて説明文：セリフ14px、行間1.9、最大幅420px
    
      【タイポ】テーマのセリフフォント、全文左揃え
      【スキーマで露出する設定】背景画像 / オーバーレイ濃度 / カード色 / 文字色 / セクション高さ
    
      雰囲気：日本のハイエンドコスメブランドのエディトリアル。静謐、余白広め、ボタンやバッジなし。
    , 製品画像の大きさと文字のカラーをカスタマイズしたい
    
    カード背景はなし
    
    画像位置を調整できるように
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height }}vh;
    overflow: hidden;
    display: block;
  }

  .ai-editorial-hero-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-hero-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_x }}% {{ block.settings.image_position_y }}%;
  }

  .ai-editorial-hero-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-hero-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-editorial-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-editorial-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .ai-editorial-hero-left-{{ ai_gen_id }} {
    flex: 0 0 41.666%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-editorial-hero-image-card-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
  }

  .ai-editorial-hero-image-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-editorial-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-editorial-hero-right-{{ ai_gen_id }} {
    flex: 0 0 50%;
    margin-left: 8.333%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-editorial-hero-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.label_size }}px;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-product-title-en-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.title_en_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-product-title-jp-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.title_jp_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-product-info-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.info_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 40px 0 0 0;
    max-width: 420px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-hero-{{ ai_gen_id }} {
      height: auto;
      min-height: 100vh;
    }

    .ai-editorial-hero-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .ai-editorial-hero-left-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
    }

    .ai-editorial-hero-right-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      margin-left: 0;
    }

    .ai-editorial-hero-description-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<editorial-hero-{{ ai_gen_id }} class="ai-editorial-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-hero-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-hero-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-editorial-hero-content-{{ ai_gen_id }}">
    <div class="ai-editorial-hero-left-{{ ai_gen_id }}">
      <div class="ai-editorial-hero-image-card-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 800 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-editorial-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-editorial-hero-right-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <p class="ai-editorial-hero-label-{{ ai_gen_id }}">{{ block.settings.label }}</p>
      {% endif %}

      {% if block.settings.product_title_en != blank %}
        <h2 class="ai-editorial-hero-product-title-en-{{ ai_gen_id }}">{{ block.settings.product_title_en }}</h2>
      {% endif %}

      {% if block.settings.product_title_jp != blank %}
        <h3 class="ai-editorial-hero-product-title-jp-{{ ai_gen_id }}">{{ block.settings.product_title_jp }}</h3>
      {% endif %}

      {% if block.settings.product_info != blank %}
        <p class="ai-editorial-hero-product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-editorial-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  </div>
</editorial-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-hero-{{ ai_gen_id }}', EditorialHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Editorial hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景画像"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "画像位置（横）",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "画像位置（縦）",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "オーバーレイ濃度",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "セクション高さ",
      "default": 90
    },
    {
      "type": "header",
      "content": "商品画像"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "商品画像"
    },
    {
      "type": "header",
      "content": "テキスト内容"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "商品詳細"
    },
    {
      "type": "text",
      "id": "product_title_en",
      "label": "商品名（英語）",
      "default": "Radiant Essence Serum"
    },
    {
      "type": "text",
      "id": "product_title_jp",
      "label": "商品名（日本語）",
      "default": "ラディアント エッセンス セラム"
    },
    {
      "type": "text",
      "id": "product_info",
      "label": "容量・価格",
      "default": "120ml　¥9,800 tax in"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>肌本来の輝きを引き出す、贅沢な美容液。厳選された植物エキスが、深く浸透し、透明感のある肌へと導きます。</p>"
    },
    {
      "type": "header",
      "content": "テキストスタイル"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#F5F0E8"
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "ラベルサイズ",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_en_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "商品名（英語）サイズ",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_jp_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "商品名（日本語）サイズ",
      "default": 16
    },
    {
      "type": "range",
      "id": "info_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "容量・価格サイズ",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "説明文サイズ",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_line_height",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "label": "説明文行間",
      "default": 1.9
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
