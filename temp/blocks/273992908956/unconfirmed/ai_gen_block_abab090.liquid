{% doc %}
  @prompt
    タイトルテキスト
    画像
    説明文
    
    上からこの順番に
    すべてを右半分に配置
    フォント位置の調節
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-right-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-content-right-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .ai-content-right-inner-{{ ai_gen_id }} {
    width: 50%;
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-content-right-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-content-right-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-content-right-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-content-right-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-content-right-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-content-right-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-content-right-inner-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-content-right-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-right-wrapper-{{ ai_gen_id }}">
    <div class="ai-content-right-inner-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-content-right-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-content-right-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-content-right-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-content-right-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.description != blank %}
        <div class="ai-content-right-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "右配置コンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトル",
      "default": "タイトルテキスト"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ここに説明文を入力してください。</p>"
    },
    {
      "type": "header",
      "content": "テキストスタイル"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトル色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "説明文サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文色",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "コンテンツ余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_spacing",
      "label": "要素間隔",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "右配置コンテンツ"
    }
  ],
  "tag": null
}
{% endschema %}
