{% doc %}
  @prompt
    【レイアウト構成】
    画面を左右2分割（50:50）したスプリットレイアウト。
    左側：テキストとボタンのセクション
    右側：画像セクション
    
    【左側セクションの詳細】
    ・背景：ホワイト（#FFFFFF）
    ・見出し：セリフ体（明朝体）で「Our Philosophy」と入力。色はダークグレー。
    ・ボタン：角丸の長方形。「View」という文字を入れ、ボタンの色は青みがかったグレー（スチールブルー）、文字色はホワイトに設定。
    ・配置：セクションの中央に寄せて配置。
    
    【右側セクションの詳細】
    ・配置：画像フレームを配置。
    ・プレースホルダー：縦長（ポートレート）の画像枠を生成。
    
    【デザインコンセプト】
    ミニマル、クリーン、高級感、余白を活かしたモダンなスタイル。
    
    左右に余白を出したい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-layout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-split-layout-container-{{ ai_gen_id }} {
    display: flex;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_margin }}px;
    gap: 0;
  }

  .ai-split-layout-left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: {{ block.settings.left_bg_color }};
    padding: {{ block.settings.content_padding }}px;
    text-align: center;
  }

  .ai-split-layout-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-split-layout-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_heading }}px 0;
    line-height: 1.3;
  }

  .ai-split-layout-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-split-layout-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-split-layout-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
  }

  .ai-split-layout-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-split-layout-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
    position: relative;
  }

  .ai-split-layout-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-layout-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-split-layout-container-{{ ai_gen_id }} {
      flex-direction: column;
      padding: 0 20px;
    }

    .ai-split-layout-left-{{ ai_gen_id }},
    .ai-split-layout-right-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-split-layout-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<split-layout-{{ ai_gen_id }} class="ai-split-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-layout-container-{{ ai_gen_id }}">
    <div class="ai-split-layout-left-{{ ai_gen_id }}">
      <h2 class="ai-split-layout-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% if block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-split-layout-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% else %}
        <span class="ai-split-layout-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </span>
      {% endif %}
    </div>

    <div class="ai-split-layout-right-{{ ai_gen_id }}">
      <div class="ai-split-layout-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-split-layout-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-split-layout-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-split-layout-empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</split-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('split-layout-{{ ai_gen_id }}', SplitLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Split layout",
  "settings": [
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "最大幅",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "horizontal_margin",
      "label": "左右の余白",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "上下の余白",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "コンテンツ内の余白",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "左側セクション"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "見出し",
      "default": "Our Philosophy"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "見出しフォント",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "見出しサイズ",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "見出し色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "spacing_below_heading",
      "label": "見出し下の余白",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "ボタン"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "ボタンテキスト",
      "default": "View"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "ボタン背景色",
      "default": "#708090"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "ボタンホバー背景色",
      "default": "#5a6a7a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "ボタンテキスト色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "ボタンフォントサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "ボタン上下パディング",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "ボタン左右パディング",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "ボタン角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "右側セクション（画像）"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "画像最大幅",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "画像アスペクト比",
      "options": [
        {
          "value": "3/4",
          "label": "ポートレート (3:4)"
        },
        {
          "value": "2/3",
          "label": "ポートレート (2:3)"
        },
        {
          "value": "9/16",
          "label": "ポートレート (9:16)"
        },
        {
          "value": "1/1",
          "label": "正方形 (1:1)"
        },
        {
          "value": "4/3",
          "label": "ランドスケープ (4:3)"
        }
      ],
      "default": "2/3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "画像角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Split layout"
    }
  ]
}
{% endschema %}
