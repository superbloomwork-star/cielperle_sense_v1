{% doc %}
  @prompt
    【ヘッダーの構成】
    ・レイアウト：横幅いっぱいのワイドレイアウト。背景は白（#FFFFFF）。
    ・左側：ロゴエリア。
    ・中央〜右寄：ナビゲーションメニュー。項目は「TOP」「ABOUT」「PRODUCTS」「NEWS」「FAQ」「CONTACT US」「INSTAGRAM」の文字とアイコン。全て大文字ので、Cormorantフォントで文字間隔を広めに設定。
    ・右端：アイコンエリア。マイページ（人型）、検索（虫眼鏡）、カート（バッグ）のアイコンを等間隔で配置。
    
    【デザインスタイル】
    ・ミニマル、ラグジュアリー、クリーン。
    ・全体的に細いラインと、十分な余白を持たせた洗練されたスタイル。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-luxury-header__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-luxury-header__logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-luxury-header__logo-image-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.nav_spacing }}px;
    flex-grow: 1;
    justify-content: {{ block.settings.nav_alignment }};
    margin: 0 {{ block.settings.nav_margin }}px;
  }

  .ai-luxury-header__nav-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: {{ block.settings.nav_text_color }};
    font-family: {{ block.settings.nav_font.family }}, {{ block.settings.nav_font.fallback_families }};
    font-weight: {{ block.settings.nav_font.weight }};
    font-size: {{ block.settings.nav_font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .ai-luxury-header__nav-item-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-luxury-header__nav-icon-{{ ai_gen_id }} {
    width: {{ block.settings.nav_icon_size }}px;
    height: {{ block.settings.nav_icon_size }}px;
  }

  .ai-luxury-header__icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-luxury-header__icon-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .ai-luxury-header__icon-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-luxury-header__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-luxury-header__nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-luxury-header__container-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | times: 0.7 }}px {{ block.settings.horizontal_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<luxury-header-{{ ai_gen_id }} class="ai-luxury-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-header__container-{{ ai_gen_id }}">
    <div class="ai-luxury-header__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <a href="/">
          <img
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ shop.name }}"
            class="ai-luxury-header__logo-image-{{ ai_gen_id }}"
            width="{{ block.settings.logo_width }}"
            height="auto"
            loading="eager"
          >
        </a>
      {% else %}
        <a href="/" style="font-size: {{ block.settings.logo_width | divided_by: 5 }}px; font-weight: 600; text-decoration: none; color: {{ block.settings.nav_text_color }};">
          {{ shop.name }}
        </a>
      {% endif %}
    </div>

    <nav class="ai-luxury-header__nav-{{ ai_gen_id }}">
      {% if block.settings.show_top %}
        <a href="{{ block.settings.top_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          TOP
        </a>
      {% endif %}

      {% if block.settings.show_about %}
        <a href="{{ block.settings.about_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          ABOUT
        </a>
      {% endif %}

      {% if block.settings.show_products %}
        <a href="{{ block.settings.products_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          PRODUCTS
        </a>
      {% endif %}

      {% if block.settings.show_news %}
        <a href="{{ block.settings.news_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          NEWS
        </a>
      {% endif %}

      {% if block.settings.show_faq %}
        <a href="{{ block.settings.faq_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          FAQ
        </a>
      {% endif %}

      {% if block.settings.show_contact %}
        <a href="{{ block.settings.contact_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}">
          CONTACT US
        </a>
      {% endif %}

      {% if block.settings.show_instagram %}
        <a href="{{ block.settings.instagram_link }}" class="ai-luxury-header__nav-item-{{ ai_gen_id }}" target="_blank" rel="noopener">
          <svg class="ai-luxury-header__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          INSTAGRAM
        </a>
      {% endif %}
    </nav>

    <div class="ai-luxury-header__icons-{{ ai_gen_id }}">
      <a href="/account" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="マイページ">
        <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="/search" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="検索">
        <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </a>

      <a href="/cart" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="カート">
        <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </a>
    </div>
  </div>
</luxury-header-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupStickyHeader();
      }

      setupStickyHeader() {
        if (!this.hasAttribute('data-sticky')) return;

        let lastScroll = 0;
        const header = this;

        window.addEventListener('scroll', function() {
          const currentScroll = window.pageYOffset;

          if (currentScroll <= 0) {
            header.style.transform = 'translateY(0)';
          } else if (currentScroll > lastScroll) {
            header.style.transform = 'translateY(-100%)';
          } else {
            header.style.transform = 'translateY(0)';
          }

          lastScroll = currentScroll;
        });
      }
    }

    customElements.define('luxury-header-{{ ai_gen_id }}', LuxuryHeader{{ ai_gen_id }});
  })();
</script>

