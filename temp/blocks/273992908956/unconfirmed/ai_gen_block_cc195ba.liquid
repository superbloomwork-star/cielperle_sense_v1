      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "最小高さ（モバイル）",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "テキストセクション"
    },
    {
      "type": "color",
      "id": "text_bg_color",
      "label": "背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "余白",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "コンテンツ最大幅",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "見出し"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "見出しテキスト",
      "default": "Our Philosophy"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "フォントサイズ",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "テキスト色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "ボタンとの間隔",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "ボタン"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "ボタンテキスト",
      "default": "View"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "背景色",
      "default": "#6b8cae"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "ホバー背景色",
      "default": "#5a7a9a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "テキスト色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "フォントサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "縦方向の余白",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "横方向の余白",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "画像セクション"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    }
  ],
  "presets": [
    {
      "name": "Split layout"
    }
  ],
  "tag": null
}
{% endschema %}
