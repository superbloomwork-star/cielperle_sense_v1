{% doc %}
  @prompt
    【構成案：Instagramフィード・グリッドセクション】
    
    1. 機能概要：
    - Instagramの公式フィードを自動反映する動的セクション。
    - 最新の投稿から順に8枚を表示。
    
    2. レイアウト構成：
    - 4カラム×2行のグリッドレイアウト。
    - 画像アスペクト比：すべて1:1（正方形）。
    - 画像間の隙間（ギャップ）：8px〜12pxの等間隔。
    
    3. インタラクション：
    - 各画像をクリックすると、該当のInstagram投稿へ飛ぶ設定。
    - マウスオーバー時に投稿内容（キャプションやいいね数）を軽くオーバーレイ表示する。
    
    4. ボタン（View More）：
    - フィードの直下に、Instagramアカウントへ誘導する「View More」ボタンを中央配置。
    - デザイン：白背景に細いグレーの枠線（アウトライン型）。
    - フォント：繊細な明朝体、またはクリーンなサンセリフ体。
    
    5. 全体デザイン：
    - 背景色：純白（#FFFFFF）
    - コンテナ幅：左右に適切な余白を持たせたレスポンシブデザイン。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-feed-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-instagram-feed-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-instagram-feed-heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.heading_margin }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-instagram-feed-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-instagram-feed-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    cursor: pointer;
  }

  .ai-instagram-feed-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-instagram-feed-item-{{ ai_gen_id }}:hover .ai-instagram-feed-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-instagram-feed-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-instagram-feed-item-{{ ai_gen_id }}:hover .ai-instagram-feed-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-instagram-feed-caption-{{ ai_gen_id }} {
    font-size: 14px;
    text-align: center;
    margin-bottom: 10px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .ai-instagram-feed-likes-{{ ai_gen_id }} {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .ai-instagram-feed-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-instagram-feed-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-instagram-feed-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-instagram-feed-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-instagram-feed-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-instagram-feed-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .ai-instagram-feed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-instagram-feed-item-{{ ai_gen_id }}:nth-child(n+7) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-feed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-instagram-feed-item-{{ ai_gen_id }}:nth-child(n+5) {
      display: none;
    }

    .ai-instagram-feed-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<instagram-feed-{{ ai_gen_id }} class="ai-instagram-feed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-feed-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-instagram-feed-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-instagram-feed-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% assign image_key = 'instagram_image_' | append: i %}
        {% assign url_key = 'instagram_url_' | append: i %}
        {% assign caption_key = 'instagram_caption_' | append: i %}
        {% assign likes_key = 'instagram_likes_' | append: i %}

        {% assign image = block.settings[image_key] %}
        {% assign url = block.settings[url_key] %}
        {% assign caption = block.settings[caption_key] %}
        {% assign likes = block.settings[likes_key] %}

        <a
          href="{% if url != blank %}{{ url }}{% else %}#{% endif %}"
          class="ai-instagram-feed-item-{{ ai_gen_id }}"
          {% if url == blank %}onclick="return false;"{% endif %}
          target="_blank"
          rel="noopener noreferrer"
        >
          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ caption | escape }}"
              loading="lazy"
              width="600"
              height="600"
              class="ai-instagram-feed-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-instagram-feed-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-instagram-feed-empty-state-{{ ai_gen_id }}">
                投稿 {{ i }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_overlay %}
            <div class="ai-instagram-feed-overlay-{{ ai_gen_id }}">
              {% if caption != blank %}
                <div class="ai-instagram-feed-caption-{{ ai_gen_id }}">{{ caption }}</div>
              {% endif %}
              {% if likes != blank %}
                <div class="ai-instagram-feed-likes-{{ ai_gen_id }}">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                  <span>{{ likes }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>

    {% if block.settings.instagram_url != blank %}
      <div class="ai-instagram-feed-button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.instagram_url }}"
          class="ai-instagram-feed-button-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</instagram-feed-{{ ai_gen_id }}>

<script>
  (function() {
    class InstagramFeed{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const items = this.querySelectorAll('.ai-instagram-feed-item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          const hasUrl = item.getAttribute('href') !== '#';
          if (!hasUrl) {
            item.style.cursor = 'default';
          }
        });
      }
    }

    customElements.define('instagram-feed-{{ ai_gen_id }}', InstagramFeed{{ ai_gen_id }});
  })();
</script>

