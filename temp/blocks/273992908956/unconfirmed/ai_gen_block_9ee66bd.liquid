{% doc %}
  @prompt
    【レイアウト】
      - セクション高さ 90vh、横幅フル、左右パディングなし
      - 背景：画像フル表示（image_picker設定、キー名 background_image）、ダークオーバーレイ調整可（0〜50%、初期値8%）
      - 中央寄せ Group ブロック、2カラム、縦中央揃え、最大幅 1200px、カラム間 80px
      - モバイル：縦積み、背景画像は全幅維持
    
      【左カラム / デスクトップ 5/12幅】
      - 商品画像ブロック1点、白カード（#FFFFFF）背景
      - カード内側パディング60px、ドロップシャドウ 0 20px 60px rgba(0,0,0,0.15)
      - 画像はobject-fit: contain、アスペクト比 3:4
    
      【右カラム / 6/12幅、1/12オフセット】
      - テキストブロックを縦に積む、グループ間24px、文字色アイボリー（#F5F0E8）
      - ラベル：セリフ12px、字間0.1em（例「商品詳細」）
      - 商品名EN：セリフ18px
      - 商品名JP：セリフ16px
      - 容量＋価格：セリフ14px（例「120ml　¥9,800 tax in」）
      - 40px空けて説明文：セリフ14px、行間1.9、最大幅420px
    
      【タイポ】テーマのセリフフォント、全文左揃え
      【スキーマで露出する設定】背景画像 / オーバーレイ濃度 / カード色 / 文字色 / セクション高さ
    
      雰囲気：日本のハイエンドコスメブランドのエディトリアル。静謐、余白広め、ボタンやバッジなし。
    , 製品画像の大きさと文字のカラーをカスタマイズしたい
    
    カード背景はなし
    
    商品画像左右移動を調整できるように
    画像をテキストを中央に
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height }}vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-editorial-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
    padding: 0 40px;
  }

  .ai-editorial-left-{{ ai_gen_id }} {
    flex: 0 0 calc(5 / 12 * 100%);
    display: flex;
    justify-content: {{ block.settings.image_horizontal_position }};
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    max-width: 100%;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-editorial-right-{{ ai_gen_id }} {
    flex: 0 0 calc(6 / 12 * 100%);
    margin-left: calc(1 / 12 * 100%);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-editorial-text-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-editorial-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: 12px;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-editorial-product-name-en-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: 18px;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-editorial-product-name-jp-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: 16px;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-editorial-capacity-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-editorial-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: 14px;
    line-height: 1.9;
    color: {{ block.settings.text_color }};
    text-align: left;
    max-width: 420px;
    margin-top: 40px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      height: auto;
      min-height: 100vh;
      padding: 60px 0;
    }

    .ai-editorial-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }

    .ai-editorial-left-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      justify-content: center;
    }

    .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      width: 80%;
    }

    .ai-editorial-right-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      margin-left: 0;
      align-items: center;
      text-align: center;
    }

    .ai-editorial-label-{{ ai_gen_id }},
    .ai-editorial-product-name-en-{{ ai_gen_id }},
    .ai-editorial-product-name-jp-{{ ai_gen_id }},
    .ai-editorial-capacity-price-{{ ai_gen_id }},
    .ai-editorial-description-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-editorial-description-{{ ai_gen_id }} {
      margin-top: 24px;
    }
  }
{% endstyle %}

<div class="ai-editorial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <div class="ai-editorial-left-{{ ai_gen_id }}">
      <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 800 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
            class="ai-editorial-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-editorial-right-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-editorial-text-group-{{ ai_gen_id }}">
          <div class="ai-editorial-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
        </div>
      {% endif %}

      {% if block.settings.product_name_en != blank %}
        <div class="ai-editorial-text-group-{{ ai_gen_id }}">
          <div class="ai-editorial-product-name-en-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</div>
        </div>
      {% endif %}

      {% if block.settings.product_name_jp != blank %}
        <div class="ai-editorial-text-group-{{ ai_gen_id }}">
          <div class="ai-editorial-product-name-jp-{{ ai_gen_id }}">{{ block.settings.product_name_jp }}</div>
        </div>
      {% endif %}

      {% if block.settings.capacity_price != blank %}
        <div class="ai-editorial-text-group-{{ ai_gen_id }}">
          <div class="ai-editorial-capacity-price-{{ ai_gen_id }}">{{ block.settings.capacity_price }}</div>
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-editorial-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial product",
  "settings": [
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景画像"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "オーバーレイ濃度",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "セクション高さ",
      "default": 90
    },
    {
      "type": "header",
      "content": "商品画像"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "商品画像"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "画像サイズ",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_horizontal_position",
      "label": "画像の左右位置",
      "options": [
        {
          "value": "flex-start",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "flex-end",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "商品詳細"
    },
    {
      "type": "text",
      "id": "product_name_en",
      "label": "商品名（英語）",
      "default": "Product Name"
    },
    {
      "type": "text",
      "id": "product_name_jp",
      "label": "商品名（日本語）",
      "default": "プロダクト名"
    },
    {
      "type": "text",
      "id": "capacity_price",
      "label": "容量・価格",
      "default": "120ml　¥9,800 tax in"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "説明文",
      "default": "静謐な時間を纏う、ハイエンドスキンケア。厳選された天然成分が肌に深く浸透し、本来の美しさを引き出します。"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#F5F0E8"
    }
  ],
  "presets": [
    {
      "name": "Editorial product"
    }
  ]
}
{% endschema %}
