{% doc %}
  @prompt
    タイトルテキスト
    画像(横並びで２つ）
    説明文（それぞれの画像の下に１つずつ）
    
    上からこの順番に
    すべてを右半分に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-right-aligned-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-right-aligned-content__wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .ai-right-aligned-content__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .ai-right-aligned-content__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-right-aligned-content__images-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    justify-content: {{ block.settings.text_alignment }};
  }

  .ai-right-aligned-content__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    max-width: calc(50% - {{ block.settings.image_gap | divided_by: 2 }}px);
  }

  .ai-right-aligned-content__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-right-aligned-content__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-right-aligned-content__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-right-aligned-content__description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 8px 0 0 0;
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-right-aligned-content__container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-right-aligned-content__images-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-right-aligned-content__image-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<right-aligned-content-{{ ai_gen_id }}
  class="ai-right-aligned-content-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-right-aligned-content__wrapper-{{ ai_gen_id }}">
    <div class="ai-right-aligned-content__container-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-right-aligned-content__title-{{ ai_gen_id }}">
          {{ block.settings.title }}
        </h2>
      {% endif %}

      <div class="ai-right-aligned-content__images-{{ ai_gen_id }}">
        <div class="ai-right-aligned-content__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_1 %}
            <img
              src="{{ block.settings.image_1 | image_url: width: 800 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
              class="ai-right-aligned-content__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-right-aligned-content__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.description_1 != blank %}
            <div class="ai-right-aligned-content__description-{{ ai_gen_id }}">
              {{ block.settings.description_1 }}
            </div>
          {% endif %}
        </div>

        <div class="ai-right-aligned-content__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img
              src="{{ block.settings.image_2 | image_url: width: 800 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
              class="ai-right-aligned-content__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-right-aligned-content__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.description_2 != blank %}
            <div class="ai-right-aligned-content__description-{{ ai_gen_id }}">
              {{ block.settings.description_2 }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</right-aligned-content-{{ ai_gen_id }}>

<script>
  (function() {
    class RightAlignedContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('right-aligned-content-{{ ai_gen_id }}', RightAlignedContent{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "右寄せコンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "タイトル"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトルテキスト",
      "default": "タイトル"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像2"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "画像の間隔",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像の角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "説明文1",
      "default": "<p>画像1の説明文</p>"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "説明文2",
      "default": "<p>画像2の説明文</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "説明文サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文カラー",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "flex-start",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "flex-end",
          "label": "右"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 30,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "右寄せコンテンツ"
    }
  ]
}
{% endschema %}
