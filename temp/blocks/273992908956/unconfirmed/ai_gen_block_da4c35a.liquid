{% doc %}
  @prompt
    【レイアウト構成】
    画面を左右2分割（50:50）したスプリットレイアウト。
    左側：テキストとボタンのセクション
    右側：画像セクション
    
    【左側セクションの詳細】
    ・背景：ホワイト（#FFFFFF）
    ・見出し：セリフ体（明朝体）で「Our Philosophy」と入力。色はダークグレー。
    ・ボタン：角丸の長方形。「View」という文字を入れ、ボタンの色は青みがかったグレー（スチールブルー）、文字色はホワイトに設定。
    ・配置：セクションの中央に寄せて配置。
    
    【右側セクションの詳細】
    ・配置：画像フレームを配置。
    ・プレースホルダー：縦長（ポートレート）の画像枠を生成。
    
    【デザインコンセプト】
    ミニマル、クリーン、高級感、余白を活かしたモダンなスタイル。
    
    左右に余白を出したい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-philosophy-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-split-philosophy-container-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-philosophy-left-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.left_bg_color }};
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.section_padding }}px;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-split-philosophy-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-align: center;
  }

  .ai-split-philosophy-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-split-philosophy-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-split-philosophy-right-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-split-philosophy-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-philosophy-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-philosophy-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 400px;
  }

  .ai-split-philosophy-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-split-philosophy-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-philosophy-left-{{ ai_gen_id }},
    .ai-split-philosophy-right-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }
{% endstyle %}

<div class="ai-split-philosophy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-philosophy-container-{{ ai_gen_id }}">
    <div class="ai-split-philosophy-left-{{ ai_gen_id }}">
      <h2 class="ai-split-philosophy-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
      {% if block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-split-philosophy-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% else %}
        <span class="ai-split-philosophy-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </span>
      {% endif %}
    </div>

    <div class="ai-split-philosophy-right-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-split-philosophy-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-philosophy-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-split-philosophy-empty-state-{{ ai_gen_id }}">
            Next, add an image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split philosophy",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Left section"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Philosophy"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "View"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#6b8cae"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#5a7a9a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Right section"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Split philosophy"
    }
  ]
}
{% endschema %}
