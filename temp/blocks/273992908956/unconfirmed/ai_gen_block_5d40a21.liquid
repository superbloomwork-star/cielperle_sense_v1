{% doc %}
  @prompt
    【レイアウト構成】
    ・背景：セクション全体にフルサイズ画像を背景として配置。
    ・前面（左側）：白い背景の大きな正方形カードを配置し、その中に商品の物撮り写真を中央に配置。
    ・前面（右側）：テキストエリア。背景の風景画像の上に直接、白または薄いグレーの文字を重ねる。
    
    【テキスト詳細】
    ・構成：上から順に「商品詳細（小見出し）」「英字商品名」「日本語商品名」「容量・価格」「商品説明文（複数行）」を配置。
    ・フォント：見出しはエレガントなセリフ体、本文は読みやすい細身のサンセリフ体。
    ・配置：左揃え。右側のエリアに十分な余白を持って配置。
    
    【デザインスタイル】
    ・エモーショナル、幻想的、高級感。
    ・背景写真のトーンに合わせて、文字色やカードの不透明度を調整。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-elegant-product-showcase-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
  }

  .ai-elegant-product-showcase__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-elegant-product-showcase__background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-elegant-product-showcase__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-elegant-product-showcase__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-elegant-product-showcase__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 32px;
    font-size: 14px;
    color: #666;
    text-align: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
  }

  .ai-elegant-product-showcase__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: {{ block.settings.content_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    min-height: {{ block.settings.section_height }}px;
  }

  .ai-elegant-product-showcase__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    aspect-ratio: 1 / 1;
  }

  .ai-elegant-product-showcase__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-elegant-product-showcase__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-elegant-product-showcase__product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-elegant-product-showcase__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .ai-elegant-product-showcase__text-area-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    text-align: left;
    padding-right: {{ block.settings.text_area_padding }}px;
  }

  .ai-elegant-product-showcase__category-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.category_font_size }}px;
    letter-spacing: {{ block.settings.category_letter_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ block.settings.category_margin }}px;
    opacity: {{ block.settings.text_opacity }};
  }

  .ai-elegant-product-showcase__title-en-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.title_en_font_size }}px;
    line-height: {{ block.settings.title_line_height }};
    margin-bottom: {{ block.settings.title_en_margin }}px;
    opacity: {{ block.settings.text_opacity }};
  }

  .ai-elegant-product-showcase__title-ja-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.title_ja_font_size }}px;
    line-height: {{ block.settings.title_line_height }};
    margin-bottom: {{ block.settings.title_ja_margin }}px;
    opacity: {{ block.settings.text_opacity }};
  }

  .ai-elegant-product-showcase__price-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.price_font_size }}px;
    margin-bottom: {{ block.settings.price_margin }}px;
    opacity: {{ block.settings.text_opacity }};
  }

  .ai-elegant-product-showcase__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.description_font_size }}px;
    line-height: {{ block.settings.description_line_height }};
    opacity: {{ block.settings.text_opacity }};
  }

  @media screen and (max-width: 989px) {
    .ai-elegant-product-showcase__content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-elegant-product-showcase__card-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: {{ block.settings.mobile_card_width }}%;
      max-width: 400px;
    }

    .ai-elegant-product-showcase__text-area-{{ ai_gen_id }} {
      padding-right: 0;
      text-align: {{ block.settings.mobile_text_align }};
    }

    .ai-elegant-product-showcase__title-en-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_en_font_size | times: 0.8 }}px;
    }

    .ai-elegant-product-showcase__title-ja-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_ja_font_size | times: 0.8 }}px;
    }

    .ai-elegant-product-showcase__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<elegant-product-showcase-{{ ai_gen_id }}
  class="ai-elegant-product-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-elegant-product-showcase__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-elegant-product-showcase__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-elegant-product-showcase__empty-state-{{ ai_gen_id }}">
          背景画像を追加してください
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-elegant-product-showcase__content-{{ ai_gen_id }}">
    <div class="ai-elegant-product-showcase__card-{{ ai_gen_id }}">
      <div class="ai-elegant-product-showcase__product-image-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 800 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-elegant-product-showcase__product-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-elegant-product-showcase__text-area-{{ ai_gen_id }}">
      {% if block.settings.category != blank %}
        <div class="ai-elegant-product-showcase__category-{{ ai_gen_id }}">
          {{ block.settings.category }}
        </div>
      {% endif %}

      {% if block.settings.title_en != blank %}
        <h2 class="ai-elegant-product-showcase__title-en-{{ ai_gen_id }}">
          {{ block.settings.title_en }}
        </h2>
      {% endif %}

      {% if block.settings.title_ja != blank %}
        <h3 class="ai-elegant-product-showcase__title-ja-{{ ai_gen_id }}">
          {{ block.settings.title_ja }}
        </h3>
      {% endif %}

      {% if block.settings.price_info != blank %}
        <div class="ai-elegant-product-showcase__price-{{ ai_gen_id }}">
          {{ block.settings.price_info }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-elegant-product-showcase__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</elegant-product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class ElegantProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustTextContrast();
      }

      adjustTextContrast() {
        const textArea = this.querySelector('.ai-elegant-product-showcase__text-area-{{ ai_gen_id }}');
        if (textArea) {
          textArea.style.textShadow = '0 1px 3px rgba(0, 0, 0, 0.3)';
        }
      }
    }

    customElements.define('elegant-product-showcase-{{ ai_gen_id }}', ElegantProductShowcase{{ ai_gen_id }});
  })();
</script>

