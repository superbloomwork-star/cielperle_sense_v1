{% doc %}
  @prompt
    タイトルテキスト
    画像(横並びで２つ）
    説明文（それぞれの画像の下に１つずつ）
    
    上からこの順番に
    すべてを右半分に配置
    
    コンテンツ幅を調節
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-image-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-two-image-block__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin-left: auto;
    margin-right: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-two-image-block__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 24px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-two-image-block__images-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    justify-content: flex-start;
  }

  .ai-two-image-block__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-two-image-block__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-image-block__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-image-block__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-two-image-block__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 12px 0 0;
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-two-image-block__container-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: auto;
    }

    .ai-two-image-block__images-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<div class="ai-two-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-image-block__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-two-image-block__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-two-image-block__images-{{ ai_gen_id }}">
      <div class="ai-two-image-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 800 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
            class="ai-two-image-block__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-two-image-block__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.description_1 != blank %}
          <div class="ai-two-image-block__description-{{ ai_gen_id }}">
            {{ block.settings.description_1 }}
          </div>
        {% endif %}
      </div>

      <div class="ai-two-image-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 800 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
            class="ai-two-image-block__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-two-image-block__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.description_2 != blank %}
          <div class="ai-two-image-block__description-{{ ai_gen_id }}">
            {{ block.settings.description_2 }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two image block",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "タイトルテキスト"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "Description",
      "default": "<p>画像の説明文がここに入ります。</p>"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "Description",
      "default": "<p>画像の説明文がここに入ります。</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#4b4b4b"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Two image block"
    }
  ]
}
{% endschema %}
