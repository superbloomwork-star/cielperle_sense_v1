    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "Mobile minimum height",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Left section"
    },
    {
      "type": "color",
