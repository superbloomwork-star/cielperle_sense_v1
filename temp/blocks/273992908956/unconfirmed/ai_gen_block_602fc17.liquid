{% doc %}
  @prompt
    【レイアウト構成】
    画面を左右2分割（50:50）したスプリットレイアウト。
    左側：テキストとボタンのセクション
    右側：全面画像セクション
    
    【左側セクションの詳細】
    ・背景：ホワイト（#FFFFFF）
    ・見出し：セリフ体（明朝体）で「Our Philosophy」と入力。色はダークグレー。
    ・ボタン：角丸の長方形。「View」という文字を入れ、ボタンの色は青みがかったグレー（スチールブルー）、文字色はホワイトに設定。
    ・配置：セクションの中央に寄せて配置。
    
    【右側セクションの詳細】
    ・配置：余白なしで画面いっぱいに広がる画像フレームを配置。
    ・プレースホルダー：縦長（ポートレート）の画像枠を生成。
    
    【デザインコンセプト】
    ミニマル、クリーン、高級感、余白を活かしたモダンなスタイル。
    ブロックを中央揃え
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-split-layout-container-{{ ai_gen_id }} {
    display: flex;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-layout-left-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.left_bg_color }};
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.left_padding }}px;
    text-align: center;
  }

  .ai-split-layout-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
  }

  .ai-split-layout-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-split-layout-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-split-layout-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-split-layout-right-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-split-layout-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-layout-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-layout-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-split-layout-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-split-layout-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-layout-left-{{ ai_gen_id }},
    .ai-split-layout-right-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }

    .ai-split-layout-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<split-layout-{{ ai_gen_id }} class="ai-split-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-layout-container-{{ ai_gen_id }}">
    <div class="ai-split-layout-left-{{ ai_gen_id }}">
      <div class="ai-split-layout-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-split-layout-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-split-layout-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
    <div class="ai-split-layout-right-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-split-layout-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-layout-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-split-layout-empty-state-{{ ai_gen_id }}">
            Next, add an image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</split-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('split-layout-{{ ai_gen_id }}', SplitLayout{{ ai_gen_id }});
  })();
</script>

