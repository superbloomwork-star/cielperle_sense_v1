{% doc %}
  @prompt
    【ヘッダーの構成】
    ・レイアウト：横幅いっぱいのワイドレイアウト。背景は白（#FFFFFF）。
    ・左側：ロゴエリア。
    ・中央〜右寄：ナビゲーションメニュー。項目は「TOP」「ABOUT」「PRODUCTS」「NEWS」「FAQ」「CONTACT US」。全て大文字ので、Cormorantフォントで文字間隔を広めに設定。
    ・右端：アイコンエリア。「INSTAGRAM」の文字とアイコン、マイページ（人型）、検索（虫眼鏡）、カート（バッグ）のアイコンを等間隔で配置。
    
    【デザインスタイル】
    ・ミニマル、ラグジュアリー、クリーン。
    ・全体的に細いラインと、十分な余白を持たせた洗練されたスタイル。
    インスタ忘れないで
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.header_padding }}px 0;
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-luxury-header__container-{{ ai_gen_id }} {
    max-width: 100%;
    padding: 0 {{ block.settings.horizontal_padding }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .ai-luxury-header__logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-luxury-header__logo-image-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-luxury-header__nav-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: {{ block.settings.nav_spacing }}px;
  }

  .ai-luxury-header__nav-list-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.nav_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-luxury-header__nav-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.nav_font.family }}, {{ block.settings.nav_font.fallback_families }};
    font-weight: {{ block.settings.nav_font.weight }};
    font-size: {{ block.settings.nav_font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-luxury-header__nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-luxury-header__icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-luxury-header__instagram-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
  }

  .ai-luxury-header__instagram-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-luxury-header__instagram-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.nav_font.family }}, {{ block.settings.nav_font.fallback_families }};
    font-weight: {{ block.settings.nav_font.weight }};
    font-size: {{ block.settings.icon_text_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
  }

  .ai-luxury-header__icon-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-luxury-header__icon-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-luxury-header__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-luxury-header__nav-list-{{ ai_gen_id }} {
      display: none;
    }

    .ai-luxury-header__container-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-luxury-header__icons-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.7 }}px;
    }

    .ai-luxury-header__instagram-text-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-header__container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.horizontal_padding | times: 0.5 }}px;
    }
  }
{% endstyle %}

<luxury-header-{{ ai_gen_id }} class="ai-luxury-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-header__container-{{ ai_gen_id }}">
    <div class="ai-luxury-header__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <a href="/">
          <img
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ shop.name }}"
            class="ai-luxury-header__logo-image-{{ ai_gen_id }}"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            loading="eager"
          >
        </a>
      {% else %}
        <a href="/" style="font-size: {{ block.settings.logo_width | times: 0.2 }}px; font-weight: 300; color: {{ block.settings.nav_text_color }}; text-decoration: none;">
          {{ shop.name }}
        </a>
      {% endif %}
    </div>

    <nav class="ai-luxury-header__nav-{{ ai_gen_id }}">
      <ul class="ai-luxury-header__nav-list-{{ ai_gen_id }}">
        {% if block.settings.nav_item_1_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_1_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_1_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.nav_item_2_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_2_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_2_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.nav_item_3_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_3_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_3_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.nav_item_4_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_4_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_4_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.nav_item_5_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_5_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_5_text }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.nav_item_6_text != blank %}
          <li>
            <a href="{{ block.settings.nav_item_6_url }}" class="ai-luxury-header__nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_item_6_text }}
            </a>
          </li>
        {% endif %}
      </ul>

      <div class="ai-luxury-header__icons-{{ ai_gen_id }}">
        {% if block.settings.instagram_url != blank %}
          <a href="{{ block.settings.instagram_url }}" class="ai-luxury-header__instagram-{{ ai_gen_id }}" target="_blank" rel="noopener">
            <span class="ai-luxury-header__instagram-text-{{ ai_gen_id }}">Instagram</span>
            <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        {% endif %}

        <a href="/account" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="Account">
          <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        <a href="/search" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="Search">
          <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </a>

        <a href="/cart" class="ai-luxury-header__icon-link-{{ ai_gen_id }}" aria-label="Cart">
          <svg class="ai-luxury-header__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</luxury-header-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupStickyHeader();
      }

      setupStickyHeader() {
        let lastScroll = 0;
        const header = this;

        window.addEventListener('scroll', () => {
          const currentScroll = window.pageYOffset;
          
          if (currentScroll > lastScroll && currentScroll > 100) {
            header.style.transform = 'translateY(-100%)';
            header.style.transition = 'transform 0.3s ease';
          } else {
            header.style.transform = 'translateY(0)';
          }
          
          lastScroll = currentScroll;
        });
      }
    }

    customElements.define('luxury-header-{{ ai_gen_id }}', LuxuryHeader{{ ai_gen_id }});
  })();
</script>

