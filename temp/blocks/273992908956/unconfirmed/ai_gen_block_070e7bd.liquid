{% doc %}
  @prompt
     【レイアウト】
      - セクション高さ 90vh、横幅フル、左右パディングなし
      - 背景：画像フル表示（image_picker設定、キー名 background_image）、ダークオーバーレイ調整可（0〜50%、初期値8%）
      - 中央寄せ Group ブロック、2カラム、縦中央揃え、最大幅 1200px、カラム間 80px
      - モバイル：縦積み、背景画像は全幅維持
    
      【左カラム / デスクトップ 5/12幅】
      - 商品画像ブロック1点
      - 画像はobject-fit: contain、アスペクト比 3:4
    
      【右カラム / 6/12幅、1/12オフセット】
      - テキストブロックを縦に積む、グループ間24px、文字色アイボリー（#F5F0E8）
      - ラベル：セリフ12px、字間0.1em（例「商品詳細」）
      - 商品名EN：セリフ18px
      - 商品名JP：セリフ16px
      - 容量＋価格：セリフ14px（例「120ml　¥9,800 tax in」）
      - 40px空けて説明文：セリフ14px、行間1.9、最大幅420px
    
      【タイポ】テーマのセリフフォント、全文左揃え
      【スキーマで露出する設定】背景画像 / オーバーレイ濃度 / カード色 / 文字色 / セクション高さ
    
      雰囲気：日本のハイエンドコスメブランドのエディトリアル。静謐、余白広め、ボタンやバッジなし。
    , 製品画像の大きさと文字のカラーをカスタマイズしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height }}vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .ai-editorial-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e8e4dc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-editorial-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    max-width: 1200px;
    width: 100%;
    padding: 0 40px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 5fr 1fr 6fr;
    gap: 80px;
    align-items: center;
  }

  .ai-editorial-image-column-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-editorial-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
  }

  .ai-editorial-product-image-{{ ai_gen_id }} img {
    width: {{ block.settings.product_image_width }}%;
    height: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .ai-editorial-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: rgba(245, 240, 232, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-editorial-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-editorial-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 12px;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-product-name-en-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 18px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-product-name-jp-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 16px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-product-details-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 14px;
    line-height: 1.9;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 40px 0 0 0;
    max-width: 420px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      height: auto;
      min-height: 100vh;
      padding: 60px 0;
    }

    .ai-editorial-container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-editorial-product-image-{{ ai_gen_id }} {
      aspect-ratio: 3 / 4;
      max-width: 400px;
      margin: 0 auto;
    }

    .ai-editorial-description-{{ ai_gen_id }} {
      margin-top: 24px;
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-editorial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-background-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      <div class="ai-editorial-image-column-{{ ai_gen_id }}">
        <div class="ai-editorial-product-image-{{ ai_gen_id }}">
          {% if block.settings.product_image %}
            <img
              src="{{ block.settings.product_image | image_url: width: 800 }}"
              alt="{{ block.settings.product_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_image.width }}"
              height="{{ block.settings.product_image.height }}"
            >
          {% else %}
            <div class="ai-editorial-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div></div>

      <div class="ai-editorial-text-column-{{ ai_gen_id }}">
        {% if block.settings.label != blank %}
          <p class="ai-editorial-label-{{ ai_gen_id }}">{{ block.settings.label }}</p>
        {% endif %}

        {% if block.settings.product_name_en != blank %}
          <h2 class="ai-editorial-product-name-en-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</h2>
        {% endif %}

        {% if block.settings.product_name_jp != blank %}
          <h3 class="ai-editorial-product-name-jp-{{ ai_gen_id }}">{{ block.settings.product_name_jp }}</h3>
        {% endif %}

        {% if block.settings.product_details != blank %}
          <p class="ai-editorial-product-details-{{ ai_gen_id }}">{{ block.settings.product_details }}</p>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-editorial-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial product",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 90
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "range",
      "id": "product_image_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image width",
      "default": 100
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "商品詳細"
    },
    {
      "type": "text",
      "id": "product_name_en",
      "label": "Product name (EN)",
      "default": "Radiance Serum"
    },
    {
      "type": "text",
      "id": "product_name_jp",
      "label": "Product name (JP)",
      "default": "ラディアンス セラム"
    },
    {
      "type": "text",
      "id": "product_details",
      "label": "Details",
      "default": "120ml　¥9,800 tax in"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>肌本来の輝きを引き出す、贅沢な美容液。厳選された植物エキスが、深く浸透し、透明感のある肌へと導きます。</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5F0E8"
    }
  ],
  "presets": [
    {
      "name": "Editorial product"
    }
  ]
}
{% endschema %}
