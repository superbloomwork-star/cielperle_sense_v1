{% doc %}
  @prompt
    タイトルテキスト
    画像(横並びで２つ）
    説明文（それぞれの画像の下に１つずつ）
    
    上からこの順番に
    すべてを右半分に配置
    
    コンテンツ幅を1間隔で調節
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-right-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px;
  }

  .ai-right-content-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}%;
    margin-left: auto;
    margin-right: 0;
  }

  .ai-right-content-title-{{ ai_gen_id }} {
    margin: 0 0 24px;
    font-size: 28px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-right-content-images-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    margin-bottom: 24px;
  }

  .ai-right-content-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-right-content-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-right-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-right-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-right-content-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-right-content-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-right-content-images-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<ai-right-content-{{ ai_gen_id }} class="ai-right-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-right-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-right-content-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-right-content-images-{{ ai_gen_id }}">
      <div class="ai-right-content-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 800 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
            class="ai-right-content-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-right-content-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.description_1 != blank %}
          <div class="ai-right-content-description-{{ ai_gen_id }}" style="margin-top: 16px;">
            {{ block.settings.description_1 }}
          </div>
        {% endif %}
      </div>

      <div class="ai-right-content-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 800 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
            class="ai-right-content-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-right-content-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.description_2 != blank %}
          <div class="ai-right-content-description-{{ ai_gen_id }}" style="margin-top: 16px;">
            {{ block.settings.description_2 }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ai-right-content-{{ ai_gen_id }}>

{% schema %}
{
  "name": "右配置コンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "タイトル"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトルテキスト",
      "default": "タイトル"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像 2"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "画像間隔",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "説明文 1",
      "default": "<p>画像1の説明文</p>"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "説明文 2",
      "default": "<p>画像2の説明文</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文カラー",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "説明文フォントサイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "コンテンツ幅",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "右配置コンテンツ"
    }
  ]
}
{% endschema %}
