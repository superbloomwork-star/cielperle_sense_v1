{% doc %}
  @prompt
    【構成案：Instagramフィード・グリッドセクション】
    
    1. 機能概要：
    - Instagramの公式フィードを自動反映する動的セクション。
    - 最新の投稿から順に8枚を表示。
    
    2. レイアウト構成：
    - 4カラム×2行のグリッドレイアウト。
    - 画像アスペクト比：すべて1:1（正方形）。
    - 画像間の隙間（ギャップ）：8px〜12pxの等間隔。
    
    3. インタラクション：
    - 各画像をクリックすると、該当のInstagram投稿へ飛ぶ設定。
    - マウスオーバー時に投稿内容（キャプションやいいね数）を軽くオーバーレイ表示する。
    
    4. ボタン（View More）：
    - フィードの直下に、Instagramアカウントへ誘導する「View More」ボタンを中央配置。
    - デザイン：白背景に細いグレーの枠線（アウトライン型）。
    - フォント：繊細な明朝体、またはクリーンなサンセリフ体。
    
    5. 全体デザイン：
    - 背景色：純白（#FFFFFF）
    - コンテナ幅：左右に適切な余白を持たせたレスポンシブデザイン。
    
    見出しなし
    下にボタンを配置して
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-feed-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-instagram-feed-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-instagram-feed-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-instagram-feed-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-instagram-feed-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-instagram-feed-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-instagram-feed-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-instagram-feed-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-instagram-feed-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-instagram-feed-link-{{ ai_gen_id }}:hover .ai-instagram-feed-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-instagram-feed-overlay-caption-{{ ai_gen_id }} {
    font-size: 12px;
    text-align: center;
    margin-bottom: 8px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-height: 1.4;
  }

  .ai-instagram-feed-overlay-likes-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 600;
  }

  .ai-instagram-feed-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-instagram-feed-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    transition: all 0.3s ease;
  }

  .ai-instagram-feed-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-instagram-feed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-feed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-instagram-feed-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.horizontal_padding | times: 0.5 }}px;
    }
  }
{% endstyle %}

<instagram-feed-{{ ai_gen_id }} class="ai-instagram-feed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-feed-container-{{ ai_gen_id }}">
    <div class="ai-instagram-feed-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign post_key = 'instagram_post_' | append: i
          assign post_url_key = 'instagram_url_' | append: i
          assign post_caption_key = 'instagram_caption_' | append: i
          assign post_likes_key = 'instagram_likes_' | append: i

          assign post_image = block.settings[post_key]
          assign post_url = block.settings[post_url_key]
          assign post_caption = block.settings[post_caption_key]
          assign post_likes = block.settings[post_likes_key]
        %}

        <div class="ai-instagram-feed-item-{{ ai_gen_id }}">
          {% if post_url != blank %}
            <a 
              href="{{ post_url }}" 
              class="ai-instagram-feed-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram投稿を見る"
            >
          {% else %}
            <div class="ai-instagram-feed-link-{{ ai_gen_id }}">
          {% endif %}

            {% if post_image %}
              <img
                src="{{ post_image | image_url: width: 600 }}"
                alt="{{ post_caption | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-instagram-feed-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-instagram-feed-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.show_overlay and post_image %}
              <div class="ai-instagram-feed-overlay-{{ ai_gen_id }}">
                {% if post_caption != blank %}
                  <div class="ai-instagram-feed-overlay-caption-{{ ai_gen_id }}">
                    {{ post_caption }}
                  </div>
                {% endif %}
                {% if post_likes != blank %}
                  <div class="ai-instagram-feed-overlay-likes-{{ ai_gen_id }}">
                    ♥ {{ post_likes }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

          {% if post_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.button_text != blank and block.settings.button_url != blank %}
      <div class="ai-instagram-feed-button-wrapper-{{ ai_gen_id }}">
        <a 
          href="{{ block.settings.button_url }}" 
          class="ai-instagram-feed-button-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</instagram-feed-{{ ai_gen_id }}>

<script>
  (function() {
    class InstagramFeed{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('instagram-feed-{{ ai_gen_id }}', InstagramFeed{{ ai_gen_id }});
  })();
</script>

