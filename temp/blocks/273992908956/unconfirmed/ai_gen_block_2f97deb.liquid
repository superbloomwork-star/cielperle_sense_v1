{% doc %}
  @prompt
    【レイアウト】
      - セクション高さ 90vh、横幅フル、左右パディングなし
      - 背景：画像フル表示（image_picker設定、キー名 background_image）、ダークオーバーレイ調整可（0〜50%、初期値8%）
      - 中央寄せ Group ブロック、2カラム、縦中央揃え、最大幅 1200px、カラム間 80px
      - モバイル：縦積み、背景画像は全幅維持
    
      【左カラム / デスクトップ 5/12幅】
      - 商品画像ブロック1点、白カード（#FFFFFF）背景
      - カード内側パディング60px、ドロップシャドウ 0 20px 60px rgba(0,0,0,0.15)
      - 画像はobject-fit: contain、アスペクト比 3:4
    
      【右カラム / 6/12幅、1/12オフセット】
      - テキストブロックを縦に積む、グループ間24px、文字色アイボリー（#F5F0E8）
      - ラベル：セリフ12px、字間0.1em（例「商品詳細」）
      - 商品名EN：セリフ18px
      - 商品名JP：セリフ16px
      - 容量＋価格：セリフ14px（例「120ml　¥9,800 tax in」）
      - 40px空けて説明文：セリフ14px、行間1.9、最大幅420px
    
      【タイポ】テーマのセリフフォント、全文左揃え
      【スキーマで露出する設定】背景画像 / オーバーレイ濃度 / カード色 / 文字色 / セクション高さ
    
      雰囲気：日本のハイエンドコスメブランドのエディトリアル。静謐、余白広め、ボタンやバッジなし。
    , 製品画像の大きさと文字のカラーをカスタマイズしたい
    
    カード背景はなし
    
    商品画像位置を調整できるように
    画像をテキストの間を調節
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height }}vh;
    overflow: hidden;
    display: block;
  }

  .ai-editorial-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e8e4dc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-editorial-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 5fr 1fr 6fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    align-items: center;
  }

  .ai-editorial-image-col-{{ ai_gen_id }} {
    grid-column: 1;
  }

  .ai-editorial-text-col-{{ ai_gen_id }} {
    grid-column: 3;
  }

  .ai-editorial-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
  }

  .ai-editorial-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-editorial-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .ai-editorial-text-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_group_gap }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    text-align: left;
  }

  .ai-editorial-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ai-editorial-title-en-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_en_size }}px;
  }

  .ai-editorial-title-jp-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_jp_size }}px;
  }

  .ai-editorial-capacity-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.capacity_price_size }}px;
  }

  .ai-editorial-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    max-width: {{ block.settings.description_max_width }}px;
    margin-top: {{ block.settings.description_top_margin }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      height: auto;
      min-height: 100vh;
      padding: 40px 20px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-editorial-image-col-{{ ai_gen_id }} {
      grid-column: 1;
    }

    .ai-editorial-text-col-{{ ai_gen_id }} {
      grid-column: 1;
    }

    .ai-editorial-product-image-{{ ai_gen_id }} {
      max-width: 400px;
      margin: 0 auto;
    }

    .ai-editorial-text-group-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-editorial-description-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: auto;
    }
  }
{% endstyle %}

<editorial-section-{{ ai_gen_id }} class="ai-editorial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-editorial-content-{{ ai_gen_id }}">
    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      <div class="ai-editorial-image-col-{{ ai_gen_id }}">
        <div class="ai-editorial-product-image-{{ ai_gen_id }}">
          {% if block.settings.product_image %}
            <img
              src="{{ block.settings.product_image | image_url: width: 800 }}"
              alt="{{ block.settings.product_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.product_image.width }}"
              height="{{ block.settings.product_image.height }}"
            >
          {% else %}
            <div class="ai-editorial-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-editorial-text-col-{{ ai_gen_id }}">
        <div class="ai-editorial-text-group-{{ ai_gen_id }}">
          {% if block.settings.label != blank %}
            <div class="ai-editorial-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
          {% endif %}

          {% if block.settings.title_en != blank %}
            <div class="ai-editorial-title-en-{{ ai_gen_id }}">{{ block.settings.title_en }}</div>
          {% endif %}

          {% if block.settings.title_jp != blank %}
            <div class="ai-editorial-title-jp-{{ ai_gen_id }}">{{ block.settings.title_jp }}</div>
          {% endif %}

          {% if block.settings.capacity_price != blank %}
            <div class="ai-editorial-capacity-price-{{ ai_gen_id }}">{{ block.settings.capacity_price }}</div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ai-editorial-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</editorial-section-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-section-{{ ai_gen_id }}', EditorialSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Editorial product",
  "settings": [
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景画像"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "オーバーレイ濃度",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "セクション高さ",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "最大幅",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "画像とテキストの間",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_group_gap",
      "label": "テキストグループ間",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "商品画像"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "商品画像"
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "商品詳細"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "商品名（英語）",
      "default": "Radiant Serum"
    },
    {
      "type": "text",
      "id": "title_jp",
      "label": "商品名（日本語）",
      "default": "ラディアント セラム"
    },
    {
      "type": "text",
      "id": "capacity_price",
      "label": "容量・価格",
      "default": "120ml　¥9,800 tax in"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "説明文",
      "default": "肌に深く浸透し、内側から輝きを引き出す美容液。厳選された植物エキスが、透明感のある肌へと導きます。"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#F5F0E8"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "header",
      "content": "タイポグラフィ"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "ラベルサイズ",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_en_size",
      "label": "商品名（英語）サイズ",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_jp_size",
      "label": "商品名（日本語）サイズ",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "capacity_price_size",
      "label": "容量・価格サイズ",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "説明文サイズ",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "説明文行間",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.9
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "説明文最大幅",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "description_top_margin",
      "label": "説明文上マージン",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Editorial product"
    }
  ]
}
{% endschema %}
