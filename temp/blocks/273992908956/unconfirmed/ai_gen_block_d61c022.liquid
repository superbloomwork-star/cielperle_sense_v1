{% doc %}
  @prompt
    【フッターの構成】
    ・レイアウト：背景はクリーンな白（#FFFFFF）。コンテンツを横一列に並べたワイドレイアウト。
    ・中央メニュー：大文字のCormorantフォントで「ABOUT」「NEW IN」「PRODUCTS」「CONTENTS」「RESAVATION」「CONTACT US」を等間隔に横並びで配置。
    ・右端メニュー：少し離れた位置に「PRIVACY POLICY」と「特定商取引法」を配置。
    ・境界線：フッターの最上部に、非常に細く薄いグレーの水平線（ボーダー）を1本配置。
    
    【デザインスタイル】
    ・フォント：小さめのサイズで、文字間隔（レタースペース）を広く取り、ミニマルで洗練された印象に。
    ・全体の雰囲気：装飾を削ぎ落とした、余白重視のモダンなスタイル。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    gap: {{ block.settings.gap }}px;
  }

  .ai-footer-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_gap }}px;
    flex-wrap: wrap;
  }

  .ai-footer-nav-{{ ai_gen_id }} a {
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.font.weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}em;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-footer-nav-{{ ai_gen_id }} a:hover {
    opacity: {{ block.settings.hover_opacity }};
  }

  .ai-footer-legal-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.legal_gap }}px;
    flex-wrap: wrap;
  }

  .ai-footer-legal-{{ ai_gen_id }} a {
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.font.weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}em;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-footer-legal-{{ ai_gen_id }} a:hover {
    opacity: {{ block.settings.hover_opacity }};
  }

  @media screen and (max-width: 989px) {
    .ai-footer-container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-footer-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_menu_gap }}px;
    }

    .ai-footer-legal-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_menu_gap }}px;
    }
  }
{% endstyle %}

<footer-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <nav class="ai-footer-nav-{{ ai_gen_id }}">
      {% if block.settings.link_1_url != blank and block.settings.link_1_text != blank %}
        <a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_text }}</a>
      {% endif %}
      {% if block.settings.link_2_url != blank and block.settings.link_2_text != blank %}
        <a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_text }}</a>
      {% endif %}
      {% if block.settings.link_3_url != blank and block.settings.link_3_text != blank %}
        <a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_text }}</a>
      {% endif %}
      {% if block.settings.link_4_url != blank and block.settings.link_4_text != blank %}
        <a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_text }}</a>
      {% endif %}
      {% if block.settings.link_5_url != blank and block.settings.link_5_text != blank %}
        <a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_text }}</a>
      {% endif %}
      {% if block.settings.link_6_url != blank and block.settings.link_6_text != blank %}
        <a href="{{ block.settings.link_6_url }}">{{ block.settings.link_6_text }}</a>
      {% endif %}
    </nav>

    <div class="ai-footer-legal-{{ ai_gen_id }}">
      {% if block.settings.legal_1_url != blank and block.settings.legal_1_text != blank %}
        <a href="{{ block.settings.legal_1_url }}">{{ block.settings.legal_1_text }}</a>
      {% endif %}
      {% if block.settings.legal_2_url != blank and block.settings.legal_2_text != blank %}
        <a href="{{ block.settings.legal_2_url }}">{{ block.settings.legal_2_text }}</a>
      {% endif %}
    </div>
  </div>
</footer-{{ ai_gen_id }}>

<script>
  (function() {
    class Footer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('footer-{{ ai_gen_id }}', Footer{{ ai_gen_id }});
  })();
</script>

