{% doc %}
  @prompt
    【レイアウト】
      - セクション高さ 90vh、横幅フル、左右パディングなし
      - 背景：画像フル表示（image_picker設定、キー名 background_image）、ダークオーバーレイ調整可（0〜50%、初期値8%）
      - 中央寄せ Group ブロック、2カラム、縦中央揃え、最大幅 1200px、カラム間 80px
      - モバイル：縦積み、背景画像は全幅維持
    
      【左カラム / デスクトップ 5/12幅】
      - 商品画像ブロック1点、白カード（#FFFFFF）背景
      - カード内側パディング60px、ドロップシャドウ 0 20px 60px rgba(0,0,0,0.15)
      - 画像はobject-fit: contain、アスペクト比 3:4
    
      【右カラム / 6/12幅、1/12オフセット】
      - テキストブロックを縦に積む、グループ間24px、文字色アイボリー（#F5F0E8）
      - ラベル：セリフ12px、字間0.1em（例「商品詳細」）
      - 商品名EN：セリフ18px
      - 商品名JP：セリフ16px
      - 容量＋価格：セリフ14px（例「120ml　¥9,800 tax in」）
      - 40px空けて説明文：セリフ14px、行間1.9、最大幅420px
    
      【タイポ】テーマのセリフフォント、全文左揃え
      【スキーマで露出する設定】背景画像 / オーバーレイ濃度 / カード色 / 文字色 / セクション高さ
    
      雰囲気：日本のハイエンドコスメブランドのエディトリアル。静謐、余白広め、ボタンやバッジなし。
    , 製品画像の大きさと文字のカラーをカスタマイズしたい
    
    カード背景はなし
    
    商品画像の左に空間
    画像をテキストを中央に
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height }}vh;
    overflow: hidden;
    display: block;
  }

  .ai-editorial-hero-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-hero-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-hero-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-hero-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-editorial-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-editorial-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
    padding: 0 40px;
  }

  .ai-editorial-hero-left-{{ ai_gen_id }} {
    flex: 0 0 calc(5 / 12 * 100%);
    display: flex;
    justify-content: flex-end;
  }

  .ai-editorial-hero-image-card-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .ai-editorial-hero-image-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-editorial-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .ai-editorial-hero-right-{{ ai_gen_id }} {
    flex: 0 0 calc(6 / 12 * 100%);
    margin-left: calc(1 / 12 * 100%);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-editorial-hero-text-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-editorial-hero-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 12px;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-product-name-en-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 18px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-product-name-jp-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 16px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
  }

  .ai-editorial-hero-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: 14px;
    line-height: 1.9;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 40px 0 0 0;
    max-width: 420px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-hero-{{ ai_gen_id }} {
      height: auto;
      min-height: 100vh;
    }

    .ai-editorial-hero-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .ai-editorial-hero-left-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      justify-content: center;
    }

    .ai-editorial-hero-image-card-{{ ai_gen_id }} {
      max-width: 300px;
    }

    .ai-editorial-hero-right-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      margin-left: 0;
    }

    .ai-editorial-hero-description-{{ ai_gen_id }} {
      margin-top: 24px;
    }
  }
{% endstyle %}

<div class="ai-editorial-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-hero-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-hero-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-editorial-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-editorial-hero-content-{{ ai_gen_id }}">
    <div class="ai-editorial-hero-left-{{ ai_gen_id }}">
      <div class="ai-editorial-hero-image-card-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 800 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-editorial-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-editorial-hero-right-{{ ai_gen_id }}">
      <div class="ai-editorial-hero-text-group-{{ ai_gen_id }}">
        {% if block.settings.label != blank %}
          <p class="ai-editorial-hero-label-{{ ai_gen_id }}">{{ block.settings.label }}</p>
        {% endif %}

        {% if block.settings.product_name_en != blank %}
          <h2 class="ai-editorial-hero-product-name-en-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</h2>
        {% endif %}

        {% if block.settings.product_name_jp != blank %}
          <h3 class="ai-editorial-hero-product-name-jp-{{ ai_gen_id }}">{{ block.settings.product_name_jp }}</h3>
        {% endif %}

        {% if block.settings.price_text != blank %}
          <p class="ai-editorial-hero-price-{{ ai_gen_id }}">{{ block.settings.price_text }}</p>
        {% endif %}
      </div>

      {% if block.settings.description != blank %}
        <div class="ai-editorial-hero-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "セクション高さ",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景画像"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "オーバーレイ濃度",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "header",
      "content": "商品画像"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "商品画像"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "画像最大幅",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "テキスト"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "商品詳細"
    },
    {
      "type": "text",
      "id": "product_name_en",
      "label": "商品名（英語）",
      "default": "Radiant Serum"
    },
    {
      "type": "text",
      "id": "product_name_jp",
      "label": "商品名（日本語）",
      "default": "ラディアント セラム"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "容量・価格",
      "default": "120ml　¥9,800 tax in"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>肌の奥深くまで浸透し、内側から輝くような透明感を引き出す美容液。厳選された植物エキスが、肌本来の美しさを呼び覚まします。</p>"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "フォント",
      "default": "serif"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#F5F0E8"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
