        "ai_gen_block_2b4055d_KbnpkM": {
          "type": "ai_gen_block_2b4055d",
          "settings": {
            "title": "５. 明るさを引き出すくすみケア",
            "image": "shopify://shop_images/2__1-05.jpg",
            "description": "<p>ナイアシンアミドや発酵由来成分(※コメ発酵液、乳酸桿菌/乳発酵液など)を配合。乾燥によるくすみを防ぎ、うるおいを与えることで、明るく健やかな印象の肌へ導きます。いきいきとしたツヤ感のある肌印象へ。忙しい日々で肌の元気が失われがちな方にもおすすめのアプローチです。</p>",
            "content_width": 50,
            "spacing": 8,
            "padding": 16,
            "text_alignment": "left",
            "title_size": 18,
            "title_color": "#707070",
            "image_radius": 0,
            "description_size": 13,
