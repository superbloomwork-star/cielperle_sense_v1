{% doc %}
  @prompt
    【LP構成：商品詳細セクション】
    ・全体の雰囲気：クリーン、ミニマル、高級感のあるスキンケアブランド。
    ・レイアウト：2カラム構成（商品のメイン画像を大きく配置。その下に、テクスチャーや使用シーンを示す4枚の画像、右側にテキストと購入ボタン）。
    
    【右側下部のコンテンツ指定】
    ・見出し：「これ1本で叶える、8つのスキンケアポイント」
    ・説明文：「保湿・整肌・保護など、スキンケアに必要な8つの機能をバランスよく配合。毎日のケアで肌本来の美しさを引き出します。」
    ・メディア配置：説明文の直下に、画像を1枚配置するためのスロット（プレースホルダー）を作成してください。
    
    【テキスト情報】
    Moisture Veil Spray Pack
    コラーゲンヴェール プッシュパック
    120ml　¥9,800 tax in
    「満ちる透明感 水光肌へ」
    内側からうるおいがにじむような水光肌へ導く美容液。透明感ケアにより乾燥によるくすみを防ぎ、肌本来の防御機能をサポートします。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-detail-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-detail-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-product-detail-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-detail-main-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-detail-sub-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.sub_image_gap }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-sub-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-detail-sub-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-product-detail-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 300;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
    letter-spacing: 0.05em;
  }

  .ai-product-detail-product-name-ja-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_ja_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-detail-product-info-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ai-product-detail-volume-{{ ai_gen_id }} {
    font-size: {{ block.settings.volume_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-product-detail-catchphrase-{{ ai_gen_id }} {
    font-size: {{ block.settings.catchphrase_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.8;
  }

  .ai-product-detail-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    margin: 0;
  }

  .ai-product-detail-button-{{ ai_gen_id }} {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    max-width: {{ block.settings.button_max_width }}px;
  }

  .ai-product-detail-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-product-detail-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.features_gap }}px;
    padding-top: {{ block.settings.features_padding_top }}px;
    border-top: {{ block.settings.features_border_width }}px solid {{ block.settings.features_border_color }};
  }

  .ai-product-detail-features-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_heading_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-detail-features-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.features_description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    margin: 0;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-detail-features-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-detail-features-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-detail-features-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-product-detail-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-detail-sub-images-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
    }

    .ai-product-detail-button-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail-container-{{ ai_gen_id }}">
    <div class="ai-product-detail-left-{{ ai_gen_id }}">
      <div class="ai-product-detail-main-image-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1200 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-product-detail-main-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-product-detail-empty-state-{{ ai_gen_id }}">
              メイン画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-product-detail-sub-images-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign sub_image_key = 'sub_image_' | append: i
            assign sub_image = block.settings[sub_image_key]
          %}
          <div class="ai-product-detail-sub-image-{{ ai_gen_id }}">
            {% if sub_image %}
              <img
                src="{{ sub_image | image_url: width: 400 }}"
                alt="{{ sub_image.alt | escape }}"
                loading="lazy"
                width="{{ sub_image.width }}"
                height="{{ sub_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail-sub-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-product-detail-right-{{ ai_gen_id }}">
      {% if block.settings.product_name != blank %}
        <h1 class="ai-product-detail-product-name-{{ ai_gen_id }}">{{ block.settings.product_name }}</h1>
      {% endif %}

      {% if block.settings.product_name_ja != blank %}
        <h2 class="ai-product-detail-product-name-ja-{{ ai_gen_id }}">{{ block.settings.product_name_ja }}</h2>
      {% endif %}

      <div class="ai-product-detail-product-info-{{ ai_gen_id }}">
        {% if block.settings.volume != blank %}
          <span class="ai-product-detail-volume-{{ ai_gen_id }}">{{ block.settings.volume }}</span>
        {% endif %}
        {% if block.settings.price != blank %}
          <span class="ai-product-detail-price-{{ ai_gen_id }}">{{ block.settings.price }}</span>
        {% endif %}
      </div>

      {% if block.settings.catchphrase != blank %}
        <p class="ai-product-detail-catchphrase-{{ ai_gen_id }}">{{ block.settings.catchphrase }}</p>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-detail-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-product-detail-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}

      <div class="ai-product-detail-features-{{ ai_gen_id }}">
        {% if block.settings.features_heading != blank %}
          <h3 class="ai-product-detail-features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h3>
        {% endif %}

        {% if block.settings.features_description != blank %}
          <div class="ai-product-detail-features-description-{{ ai_gen_id }}">{{ block.settings.features_description }}</div>
        {% endif %}

        <div class="ai-product-detail-features-image-{{ ai_gen_id }}">
          {% if block.settings.features_image %}
            <img
              src="{{ block.settings.features_image | image_url: width: 800 }}"
              alt="{{ block.settings.features_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.features_image.width }}"
              height="{{ block.settings.features_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail-features-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-product-detail-features-empty-state-{{ ai_gen_id }}">
                機能説明用の画像を追加してください
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
