{% doc %}
  @prompt
    3枚のスライドショー
    カルーセルは中央下部に白点で表現。
    
    画像の真ん中にロゴとコンセプト文章を入れる。(中央揃え)
    フォントと改行が自由にできるようにカスタマイズ
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-slideshow-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slideshow_height }}px;
  }

  .ai-slideshow-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    pointer-events: none;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-slideshow-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-slideshow-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: 90%;
    max-width: 800px;
  }

  .ai-slideshow-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_margin_bottom }}px;
  }

  .ai-slideshow-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-slideshow-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
    white-space: pre-wrap;
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
  }

  .ai-slideshow-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.dots_bottom_position }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: {{ block.settings.dots_gap }}px;
    z-index: 3;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: {{ block.settings.dot_opacity }};
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.slideshow_height_mobile }}px;
    }

    .ai-slideshow-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-slideshow-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<slideshow-carousel-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slideshow-wrapper-{{ ai_gen_id }}">
    <div class="ai-slideshow-slides-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'slide_' | append: i | append: '_image'
          assign text_key = 'slide_' | append: i | append: '_text'
          assign logo_key = 'slide_' | append: i | append: '_logo'
          
          assign slide_image = block.settings[image_key]
          assign slide_text = block.settings[text_key]
          assign slide_logo = block.settings[logo_key]
        %}
        
        <div class="ai-slideshow-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-slideshow-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slideshow-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          
          <div class="ai-slideshow-content-{{ ai_gen_id }}">
            {% if slide_logo %}
              <div class="ai-slideshow-logo-{{ ai_gen_id }}">
                <img
                  src="{{ slide_logo | image_url: width: 800 }}"
                  alt="Logo"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ slide_logo.width }}"
                  height="{{ slide_logo.height }}"
                >
              </div>
            {% endif %}
            
            {% if slide_text != blank %}
              <div class="ai-slideshow-text-{{ ai_gen_id }}">{{ slide_text }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    
    <div class="ai-slideshow-dots-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button
          class="ai-slideshow-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index }}"
          aria-label="スライド {{ forloop.index }} に移動"
        ></button>
      {% endfor %}
    </div>
  </div>
</slideshow-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class SlideshowCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(slideNumber) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });
        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        this.slides[slideNumber - 1].classList.add('active');
        this.dots[slideNumber - 1].classList.add('active');
        this.currentSlide = slideNumber;
      }

      nextSlide() {
        let next = this.currentSlide + 1;
        if (next > this.totalSlides) {
          next = 1;
        }
        this.goToSlide(next);
      }

      startAutoplay() {
        const autoplayEnabled = {{ block.settings.autoplay }};
        const autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;
        
        if (autoplayEnabled) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, autoplaySpeed);
        }
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('slideshow-carousel-{{ ai_gen_id }}', SlideshowCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "スライドショー",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "スライドショー設定"
    },
    {
      "type": "range",
      "id": "slideshow_height",
      "label": "高さ（デスクトップ）",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "slideshow_height_mobile",
