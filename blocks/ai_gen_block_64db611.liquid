{% doc %}
  @prompt
    左半分を画像
    右半分をブランドロゴ、ロゴのふりがな、説明文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-brand-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
  }

  .ai-brand-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    position: relative;
  }

  .ai-brand-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-brand-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-brand-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-brand-content-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.content_alignment }};
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-brand-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_margin_bottom }}px;
  }

  .ai-brand-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-brand-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 80px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-brand-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-brand-furigana-{{ ai_gen_id }} {
    font-size: {{ block.settings.furigana_size }}px;
    color: {{ block.settings.furigana_color }};
    margin-bottom: {{ block.settings.furigana_margin_bottom }}px;
    line-height: 1.5;
  }

  .ai-brand-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    max-width: {{ block.settings.description_max_width }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-brand-image-wrapper-{{ ai_gen_id }},
    .ai-brand-content-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .ai-brand-content-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<brand-section-{{ ai_gen_id }}
  class="ai-brand-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-brand-container-{{ ai_gen_id }}">
    <div class="ai-brand-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.brand_image %}
        <img
          src="{{ block.settings.brand_image | image_url: width: 1200 }}"
          alt="{{ block.settings.brand_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.brand_image.width }}"
          height="{{ block.settings.brand_image.height }}"
          class="ai-brand-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-brand-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-brand-content-wrapper-{{ ai_gen_id }}">
      {% if block.settings.brand_logo %}
        <div class="ai-brand-logo-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.brand_logo | image_url: width: 600 }}"
            alt="{{ block.settings.brand_logo.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.brand_logo.width }}"
            height="{{ block.settings.brand_logo.height }}"
          >
        </div>
      {% else %}
        <div class="ai-brand-logo-{{ ai_gen_id }}">
          <div class="ai-brand-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.furigana != blank %}
        <div class="ai-brand-furigana-{{ ai_gen_id }}">
          {{ block.settings.furigana }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-brand-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</brand-section-{{ ai_gen_id }}>

{% schema %}
{
  "name": "ブランド紹介",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "ブランド画像"
    },
    {
      "type": "header",
      "content": "ブランドロゴ"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "ロゴ画像"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "ロゴ幅",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_margin_bottom",
      "label": "ロゴ下余白",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "ふりがな"
    },
    {
      "type": "richtext",
      "id": "furigana",
      "label": "ふりがなテキスト",
      "default": "<p>ブランド名のふりがな</p>"
    },
    {
      "type": "range",
      "id": "furigana_size",
      "label": "ふりがなサイズ",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "furigana_color",
      "label": "ふりがな色",
      "default": "#8f9eb2"
    },
    {
      "type": "range",
      "id": "furigana_margin_bottom",
      "label": "ふりがな下余白",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "説明文"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>ブランドの説明文をここに入力してください。</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "説明文サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文色",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "説明文最大幅",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "コンテンツエリア"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "パディング",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "背景色",
      "default": "#fdfbf7"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "ブランド紹介"
    }
  ]
}
{% endschema %}
