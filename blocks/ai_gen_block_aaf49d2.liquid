      width: 100%;
    }
  }
{% endstyle %}

<product-detail-{{ ai_gen_id }} class="ai-product-detail-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-detail__container-{{ ai_gen_id }}">
    <div class="ai-product-detail__left-{{ ai_gen_id }}">
      <div class="ai-product-detail__main-image-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1200 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-product-detail__main-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-product-detail__sub-images-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign sub_image_key = 'sub_image_' | append: i
            assign sub_image = block.settings[sub_image_key]
          %}
          <div class="ai-product-detail__sub-image-{{ ai_gen_id }}">
            {% if sub_image %}
              <img
                src="{{ sub_image | image_url: width: 400 }}"
                alt="{{ sub_image.alt | escape }}"
                loading="lazy"
                width="{{ sub_image.width }}"
                height="{{ sub_image.height }}"
              >
            {% else %}
              <div class="ai-product-detail__sub-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-product-detail__right-{{ ai_gen_id }}">
      {% if block.settings.product_name_en != blank %}
        <h2 class="ai-product-detail__product-name-en-{{ ai_gen_id }}">{{ block.settings.product_name_en }}</h2>
      {% endif %}

      {% if block.settings.product_name_ja != blank %}
        <h3 class="ai-product-detail__product-name-ja-{{ ai_gen_id }}">{{ block.settings.product_name_ja }}</h3>
      {% endif %}

      {% if block.settings.product_info != blank %}
        <p class="ai-product-detail__product-info-{{ ai_gen_id }}">{{ block.settings.product_info }}</p>
      {% endif %}

      {% if block.settings.product_price != blank %}
        <p class="ai-product-detail__product-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</p>
      {% endif %}

      {% if block.settings.product_tagline != blank %}
        <p class="ai-product-detail__product-tagline-{{ ai_gen_id }}">{{ block.settings.product_tagline }}</p>
      {% endif %}

      {% if block.settings.product_description != blank %}
        <div class="ai-product-detail__product-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</div>
      {% endif %}

      <div class="ai-product-detail__quantity-{{ ai_gen_id }}">
        <span class="ai-product-detail__quantity-label-{{ ai_gen_id }}">{{ block.settings.quantity_label }}</span>
        <div class="ai-product-detail__quantity-controls-{{ ai_gen_id }}">
          <button
            class="ai-product-detail__quantity-button-{{ ai_gen_id }}"
            data-action="decrease"
            aria-label="数量を減らす"
          >
            −
          </button>
          <input
            type="number"
            class="ai-product-detail__quantity-input-{{ ai_gen_id }}"
            value="1"
            min="1"
            max="99"
            aria-label="数量"
          >
          <button
            class="ai-product-detail__quantity-button-{{ ai_gen_id }}"
            data-action="increase"
            aria-label="数量を増やす"
          >
            +
          </button>
        </div>
      </div>

      <div class="ai-product-detail__buttons-{{ ai_gen_id }}">
        <button class="ai-product-detail__button-{{ ai_gen_id }}">
          {{ block.settings.purchase_button_label }}
        </button>
        <button class="ai-product-detail__button-{{ ai_gen_id }} ai-product-detail__button--secondary-{{ ai_gen_id }}">
          {{ block.settings.subscription_button_label }}
        </button>
      </div>

      <div class="ai-product-detail__features-{{ ai_gen_id }}">
        {% if block.settings.features_heading != blank %}
          <h4 class="ai-product-detail__features-heading-{{ ai_gen_id }}">{{ block.settings.features_heading }}</h4>
        {% endif %}

        {% if block.settings.features_description != blank %}
          <div class="ai-product-detail__features-description-{{ ai_gen_id }}">{{ block.settings.features_description }}</div>
        {% endif %}

        <div class="ai-product-detail__features-image-{{ ai_gen_id }}">
          {% if block.settings.features_image %}
            <img
              src="{{ block.settings.features_image | image_url: width: 800 }}"
              alt="{{ block.settings.features_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.features_image.width }}"
              height="{{ block.settings.features_image.height }}"
            >
          {% else %}
            <div class="ai-product-detail__features-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</product-detail-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDetail{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-detail__quantity-input-{{ ai_gen_id }}');
        this.decreaseButton = this.querySelector('[data-action="decrease"]');
        this.increaseButton = this.querySelector('[data-action="increase"]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.decreaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          const minValue = parseInt(this.quantityInput.min);
          if (currentValue > minValue) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.increaseButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          const maxValue = parseInt(this.quantityInput.max);
          if (currentValue < maxValue) {
            this.quantityInput.value = currentValue + 1;
          }
        });

        this.quantityInput.addEventListener('input', () => {
          const value = parseInt(this.quantityInput.value);
          const minValue = parseInt(this.quantityInput.min);
          const maxValue = parseInt(this.quantityInput.max);

          if (value < minValue) {
            this.quantityInput.value = minValue;
          } else if (value > maxValue) {
            this.quantityInput.value = maxValue;
          }
        });
      }
    }

    customElements.define('product-detail-{{ ai_gen_id }}', ProductDetail{{ ai_gen_id }});
  })();
</script>

