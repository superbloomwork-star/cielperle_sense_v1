{% doc %}
  @prompt
    右寄せで横ラインを一本, 右寄せだけど右壁付はしたくない, Desktop widthを48に変更, Desktop widthの調節を1刻みで変更できるようにして, Right spacingの調節を1刻みで変更できるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-line-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-right: {{ block.settings.right_spacing }}px;
  }

  .ai-line-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    margin-left: auto;
  }

  .ai-line-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    border: none;
    margin: 0;
  }
{% endstyle %}

<div class="ai-line-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-line-wrapper-{{ ai_gen_id }}">
    <hr class="ai-line-{{ ai_gen_id }}">
  </div>
</div>

{% schema %}
{
  "name": "Horizontal line",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "right_spacing",
      "label": "Right spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Horizontal line"
    }
  ]
}
{% endschema %}