{% doc %}
  @prompt
    【フッターの構成】
    ・レイアウト：背景はクリーンな白（#FFFFFF）。コンテンツを横一列に並べたワイドレイアウト。
    ・中央メニュー：大文字のCormorantフォントで「ABOUT」「NEW IN」「PRODUCTS」「CONTENTS」「RESAVATION」「CONTACT US」を等間隔に横並びで配置。
    ・右端メニュー：少し離れた位置に「PRIVACY POLICY」と「特定商取引法」を配置。
    ・境界線：フッターの最上部に、非常に細く薄いグレーの水平線（ボーダー）を1本配置。
    
    【デザインスタイル】
    ・フォント：小さめのサイズで、文字間隔（レタースペース）を広く取り、ミニマルで洗練された印象に。
    ・全体の雰囲気：装飾を削ぎ落とした、余白重視のモダンなスタイル。
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.padding_horizontal }}px;
    border-top: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    padding-top: {{ block.settings.padding_vertical }}px;
  }

  .ai-footer-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: {{ block.settings.gap }}px;
  }

  .ai-footer-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_gap }}px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}em;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    opacity: 0.6;
  }

  .ai-footer-secondary-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.secondary_gap }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-footer-content-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-footer-nav-{{ ai_gen_id }} {
      flex-wrap: wrap;
      gap: {{ block.settings.mobile_menu_gap }}px;
    }

    .ai-footer-secondary-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: {{ block.settings.mobile_menu_gap }}px;
    }

    .ai-footer-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<footer-minimal-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-content-{{ ai_gen_id }}">
      <nav class="ai-footer-nav-{{ ai_gen_id }}">
        {% if block.settings.link_1_text != blank %}
          <a href="{{ block.settings.link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_1_text }}
          </a>
        {% endif %}
        {% if block.settings.link_2_text != blank %}
          <a href="{{ block.settings.link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_2_text }}
          </a>
        {% endif %}
        {% if block.settings.link_3_text != blank %}
          <a href="{{ block.settings.link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_3_text }}
          </a>
        {% endif %}
        {% if block.settings.link_4_text != blank %}
          <a href="{{ block.settings.link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_4_text }}
          </a>
        {% endif %}
        {% if block.settings.link_5_text != blank %}
          <a href="{{ block.settings.link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_5_text }}
          </a>
        {% endif %}
        {% if block.settings.link_6_text != blank %}
          <a href="{{ block.settings.link_6_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_6_text }}
          </a>
        {% endif %}
      </nav>

      <div class="ai-footer-secondary-{{ ai_gen_id }}">
        {% if block.settings.secondary_link_1_text != blank %}
          <a href="{{ block.settings.secondary_link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.secondary_link_1_text }}
          </a>
        {% endif %}
        {% if block.settings.secondary_link_2_text != blank %}
          <a href="{{ block.settings.secondary_link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.secondary_link_2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</footer-minimal-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterMinimal{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('footer-minimal-{{ ai_gen_id }}', FooterMinimal{{ ai_gen_id }});
  })();
</script>

