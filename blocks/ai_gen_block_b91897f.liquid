{% doc %}
  @prompt
    タイトルテキスト
    説明文
    
    上からこの順番に
    すべてを右半分に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-right-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-right-content-wrapper-{{ ai_gen_id }} {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-right-content-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: {{ block.settings.title_weight }};
  }

  .ai-right-content-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-right-content-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-right-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-right-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-right-content-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    
    {% if block.settings.description != blank %}
      <div class="ai-right-content-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "右配置コンテンツ",
  "settings": [
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "タイトル",
      "default": "タイトルテキスト"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>説明文</p>"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "要素間のスペース",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "label": "パディング",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "タイトルスタイル"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "フォントサイズ",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "フォントウェイト",
      "options": [
        {
          "value": "300",
          "label": "ライト"
        },
        {
          "value": "400",
          "label": "ノーマル"
        },
        {
          "value": "500",
          "label": "ミディアム"
        },
        {
          "value": "600",
          "label": "セミボールド"
        },
        {
          "value": "700",
          "label": "ボールド"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "説明文スタイル"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "フォントサイズ",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "テキストカラー",
      "default": "#4b4b4b"
    }
  ],
  "presets": [
    {
      "name": "右配置コンテンツ"
    }
  ]
}
{% endschema %}
